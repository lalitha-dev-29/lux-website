---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url';
import { fetchAllPublishedCaseStudies, fetchAllPublishedJournalPosts } from '../../lib/buildTimeData';
import { renderMarkdown } from '../../lib/markdown';
import ContentMetadata from '../../components/ContentMetadata.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import PDFViewer from '../../components/PDFViewer.astro';

export async function getStaticPaths() {
  const [caseStudies, journalPosts] = await Promise.all([
    fetchAllPublishedCaseStudies(),
    fetchAllPublishedJournalPosts(),
  ]);
  return caseStudies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, caseStudies, journalPosts },
  }));
}

const { entry: c, caseStudies, journalPosts } = Astro.props;
const contentHtml = renderMarkdown(c.content);
---

<Layout
  title={`${c.title} | Case Studies | Kasturi Lalitha Manogna`}
  description={c.seo_description || c.excerpt}
  ogImage={c.og_image || c.cover_image || undefined}
  ogType="article"
>
  <section class="tight case-detail-head">
    <div class="container">
      <a href={withBase('/case-studies/')} class="btn-line case-back reveal"><span class="arrow" aria-hidden="true">←</span> All Case Studies</a>
      <div class="reveal">
        <ContentMetadata category={c.category} author={c.author} publishedAt={c.published_at} readingTimeMinutes={c.reading_time_minutes} />
        <h1 class="case-detail-title">{c.title}</h1>
        {c.tags.length > 0 && <div class="tags" style="margin-top:var(--sp-5);">{c.tags.map((t) => <span>{t}</span>)}</div>}
      </div>
    </div>
  </section>

  {c.cover_image && (
    <section class="tight flush-top">
      <div class="container">
        <div class="case-detail-media reveal">
          <img src={c.cover_image} alt="" width="1600" height="800" />
        </div>
      </div>
    </section>
  )}

  <section class="tight">
    <div class="container">
      {contentHtml && <div class="prose reveal" set:html={contentHtml} />}
      <ExternalLinks links={c.links} />
    </div>
  </section>

  <section class="tight flush-top">
    <div class="container">
      <h2 class="visually-hidden">Full case study document</h2>
      <PDFViewer pdfUrl={c.pdf_url} title={c.title} />
    </div>
  </section>

  <RelatedContent
    currentSlug={c.slug}
    currentKind="case-study"
    currentTags={c.tags}
    currentCategory={c.category}
    journalPosts={journalPosts}
    caseStudies={caseStudies}
  />
</Layout>
