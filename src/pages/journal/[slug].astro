---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url';
import { fetchAllPublishedJournalPosts, fetchAllPublishedCaseStudies } from '../../lib/buildTimeData';
import { renderMarkdown } from '../../lib/markdown';
import ContentMetadata from '../../components/ContentMetadata.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { effectiveLinks } from '../../lib/contentLinks';

export async function getStaticPaths() {
  const [journalPosts, caseStudies] = await Promise.all([
    fetchAllPublishedJournalPosts(),
    fetchAllPublishedCaseStudies(),
  ]);
  return journalPosts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, journalPosts, caseStudies },
  }));
}

const { entry: post, journalPosts, caseStudies } = Astro.props;
const contentHtml = renderMarkdown(post.content);
const links = effectiveLinks(post.links, post.external_url);
---

<Layout
  title={`${post.title} | Journal | Kasturi Lalitha Manogna`}
  description={post.seo_description || post.excerpt}
  ogImage={post.og_image || post.cover_image || undefined}
  ogType="article"
>
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <section class="tight case-detail-head">
    <div class="container">
      <a href={withBase('/journal/')} class="btn-line case-back reveal"><span class="arrow" aria-hidden="true">←</span> All Journal Posts</a>
      <div class="reveal">
        <ContentMetadata category={post.category} author={post.author} publishedAt={post.published_at} readingTimeMinutes={post.reading_time_minutes} />
        <h1 class="case-detail-title">{post.title}</h1>
        {post.tags.length > 0 && <div class="tags" style="margin-top:var(--sp-5);">{post.tags.map((t) => <span>{t}</span>)}</div>}
      </div>
    </div>
  </section>

  {post.cover_image && (
    <section class="tight flush-top">
      <div class="container">
        <div class="case-detail-media reveal">
          <img src={post.cover_image} alt="" width="1600" height="800" />
        </div>
      </div>
    </section>
  )}

  <section class="tight" id="articleSection">
    <div class="container">
      {contentHtml ? (
        <div class="prose reveal" id="articleContent" set:html={contentHtml} />
      ) : (
        <p class="journal-status" id="articleContent">This post doesn't have on-site content yet — see the link below.</p>
      )}
      <ExternalLinks links={links} />
    </div>
  </section>

  <RelatedContent
    currentSlug={post.slug}
    currentKind="journal"
    currentTags={post.tags}
    currentCategory={post.category}
    journalPosts={journalPosts}
    caseStudies={caseStudies}
  />
</Layout>

<script>
  const bar = document.getElementById('readingProgress');

  if (bar) {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bar.classList.add('reading-progress-animated');
    }

    /*
      Progress is measured over the whole document rather than just the
      article element. An earlier article-relative version was wrong in both
      directions: it stayed at 0% for posts shorter than the viewport (which
      most link-out posts are), and never reached 100% on long ones, because
      the page also contains the hero, cover image and related-content
      sections outside the measured element. Document scroll is what the
      reader actually perceives as "how far through this page am I".
    */
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) * 100 : 0;
      bar.style.width = `${pct}%`;
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
