---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url';
---

<Layout title="Journal | Kasturi Lalitha Manogna">
  <section class="tight case-detail-head">
    <div class="container">
      <a href={withBase('/journal/')} class="btn-line case-back"><span class="arrow" aria-hidden="true">←</span> All Journal Posts</a>
      <div id="postHead">
        <p class="journal-status" id="postLoading">Loading…</p>
      </div>
    </div>
  </section>

  <section class="tight flush-top">
    <div class="container">
      <div class="prose" id="postContent"></div>
    </div>
  </section>
</Layout>

<script>
  import { fetchPublishedJournalPostBySlug } from '../../lib/journalClient';
  import { renderJournalContent } from '../../lib/journalTypes';
  import { escapeHtml, safeUrl } from '../../lib/html';

  const params = new URLSearchParams(window.location.search);
  const slug = params.get('slug');
  const head = document.getElementById('postHead')!;
  const content = document.getElementById('postContent')!;

  async function load() {
    if (!slug) {
      head.innerHTML = '<p class="journal-status">No post specified.</p>';
      return;
    }
    const post = await fetchPublishedJournalPostBySlug(slug);
    if (!post) {
      head.innerHTML = '<p class="journal-status">This post isn\'t available. It may have been unpublished or removed.</p>';
      document.title = 'Journal | Kasturi Lalitha Manogna';
      return;
    }

    document.title = `${post.title} | Journal | Kasturi Lalitha Manogna`;

    const meta = [post.category, post.published_at ? new Date(post.published_at).toLocaleDateString() : null]
      .filter(Boolean)
      .join(' · ');

    head.innerHTML = `
      ${meta ? `<div class="card-meta">${escapeHtml(meta)}</div>` : ''}
      <h1 class="case-detail-title">${escapeHtml(post.title)}</h1>
      ${post.tags.length ? `<div class="tags" style="margin-top:var(--sp-5);">${post.tags.map((t) => `<span>${escapeHtml(t)}</span>`).join('')}</div>` : ''}
    `;

    if (post.content) {
      content.innerHTML = renderJournalContent(post.content);
    } else if (post.external_url) {
      content.innerHTML = `<p><a class="btn-line" href="${safeUrl(post.external_url)}" target="_blank" rel="noopener">View on LinkedIn <span class="arrow" aria-hidden="true">→</span></a></p>`;
    }
  }

  load();
</script>
