---
import Layout from '../layouts/Layout.astro';
import LearningCertCard from '../components/LearningCertCard.astro';
import { fetchLearningOverview, fetchAllRightNow, fetchAllEducation, fetchAllCertifications } from '../lib/buildTimeData';
import { formatEducationPeriod } from '../lib/learningTypes';

const [overview, learningNow, education, certifications] = await Promise.all([
  fetchLearningOverview(),
  fetchAllRightNow(),
  fetchAllEducation(),
  fetchAllCertifications(),
]);
---

<Layout title="Learning | Kasturi Lalitha Manogna">
  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Learning</span>
        <h1>{overview.heading}</h1>
        <p>{overview.description}</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Right Now</span>
        <h2>What I'm Currently Learning About</h2>
      </div>
      <div class="grid-2">
        {learningNow.map((item, i) => (
          <article class={`card card-numbered reveal ${i % 2 === 1 ? 'reveal-delay-1' : ''}`}>
            <div class="card-body">
              <span class="card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p class="excerpt">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Education</span>
        {/* Mirrors the eyebrow so the section has a real heading for screen
            readers without adding any new visible copy. */}
        <h2 class="visually-hidden">Education</h2>
      </div>
      <div class="grid-2">
        {education.map((item, i) => (
          <article class={`card reveal ${i % 2 === 1 ? 'reveal-delay-1' : ''}`}>
            <div class="card-body">
              <div class="issuer">{item.institution} <span class="date">· {formatEducationPeriod(item)}</span></div>
              <h3>{item.programme}</h3>
              <p class="excerpt">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Certifications</span>
        <h2>Courses &amp; Credentials</h2>
      </div>
      {certifications.length ? (
        <div class="grid-3">
          {certifications.map((entry, i) => (
            <LearningCertCard entry={entry} revealClass={i % 3 === 1 ? 'reveal-delay-1' : i % 3 === 2 ? 'reveal-delay-2' : ''} />
          ))}
        </div>
      ) : (
        <div class="empty-state reveal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10z" />
            <path d="M8.5 13.5L7 21l5-2.5 5 2.5-1.5-7.5" />
          </svg>
          <p>No certifications added yet. This section will grow as I complete new courses and credentials.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
  import { initCertDialogs } from '../scripts/certDialogs';
  import { initCertPdfThumbnails } from '../scripts/certPdfThumbnails';
  initCertDialogs();
  initCertPdfThumbnails();
</script>
