---
import Layout from '../layouts/Layout.astro';

const topics = [
  { title: 'Luxury Strategy', body: 'How luxury brands build desire, protect value and stay relevant.' },
  { title: 'Consumer Psychology', body: 'Why we want certain brands and what those brands mean to us.' },
  { title: 'Brand Breakdowns', body: 'Looking closely at the decisions behind well known brands.' },
  { title: 'Culture & Luxury', body: 'How changing culture changes the meaning of luxury.' },
  { title: 'Gen Z & Luxury', body: 'What younger consumers are changing about aspiration, identity and consumption.' },
];
---

<Layout title="Journal | Kasturi Lalitha Manogna">
  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The Journal</span>
        <h1>Things I'm Thinking About in Luxury Marketing</h1>
        <p>I use LinkedIn to share things I find interesting, but also to work through my own thoughts. Sometimes it's a brand I've been studying. Sometimes it's a campaign. Sometimes it's a consumer behaviour that made me stop and think. And sometimes it's simply a question I wanted to explore. This is where I keep those thoughts.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">What I Write About</span>
        {/* Mirrors the eyebrow so the section has a real heading for screen
            readers without adding any new visible copy. */}
        <h2 class="visually-hidden">What I Write About</h2>
      </div>
      <div class="grid-3">
        {topics.map((t, i) => (
          <article class={`card card-numbered reveal ${i % 3 === 1 ? 'reveal-delay-1' : i % 3 === 2 ? 'reveal-delay-2' : ''}`}>
            <div class="card-body">
              <span class="card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 set:html={t.title.replace('&', '&amp;')} />
              <p class="excerpt">{t.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      <h2 class="visually-hidden">Journal posts</h2>
      <div id="journalPosts">
        <p class="journal-status" id="journalLoading">Loading posts…</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container split">
      <div class="split-aside reveal">
        <div class="section-head">
          <span class="eyebrow">My Journal</span>
          <h2 class="visually-hidden">My Journal</h2>
        </div>
      </div>
      <div class="split-body reveal reveal-delay-1">
        <div class="prose">
          <p>I don't write because I think I have everything figured out. I write because I like exploring ideas.</p>
          <p>And sometimes writing something down is the best way to understand what I actually think.</p>
        </div>
        <div class="cta-inline">
          <a href="https://www.linkedin.com/in/lalitha-manogna-kasturi/" target="_blank" rel="noopener" class="btn-solid">
            Follow Me on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchPublishedJournalPosts } from '../lib/journalClient';
  import { renderJournalListItem } from '../lib/journalPublic';

  const container = document.getElementById('journalPosts')!;

  fetchPublishedJournalPosts().then((posts) => {
    if (!posts) {
      container.innerHTML = '<p class="journal-status">Unable to load Journal posts right now.</p>';
      return;
    }
    if (posts.length === 0) {
      container.innerHTML = '<p class="journal-status">No posts yet — check back soon.</p>';
      return;
    }
    container.innerHTML = posts.map(renderJournalListItem).join('');
  });
</script>
