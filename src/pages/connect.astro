---
import Layout from '../layouts/Layout.astro';
import ConnectForm from '../components/ConnectForm.astro';
---

<Layout title="Work With Me | Lalitha Manogna Kasturi">
  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Work With Me</span>
        <h2>I'd Love to Hear From You</h2>
        <p>I'm currently building my career in luxury brand management and marketing strategy, with the long term goal of working in global brand strategy for an iconic maison. I'm especially interested in opportunities where I can combine research, strategy, consumer understanding and creative thinking.</p>
      </div>
    </div>
  </section>

  <section class="tight" style="padding-top:0;">
    <div class="container">
      <div class="grid-3">
        <article class="card reveal">
          <div class="card-body">
            <h3>Looking for Your Next Luxury Marketer?</h3>
            <p class="excerpt">I'd love to connect if you're looking for someone who is curious about luxury, comfortable with research and analysis, and genuinely interested in understanding consumers and brands.</p>
            <div class="cta-inline"><a href="#connect-form" class="btn-line">View My CV <span class="arrow">→</span></a></div>
          </div>
        </article>
        <article class="card reveal reveal-delay-1">
          <div class="card-body">
            <h3>If You're in the Industry</h3>
            <p class="excerpt">If you work in luxury, marketing, branding, consumer strategy or creative direction, I'm always happy to connect and learn from people in the industry.</p>
            <div class="cta-inline"><a href="https://www.linkedin.com/in/lalitha-manogna-kasturi/" target="_blank" rel="noopener" class="btn-line">Connect on LinkedIn <span class="arrow">→</span></a></div>
          </div>
        </article>
        <article class="card reveal reveal-delay-2">
          <div class="card-body">
            <h3>If You Have an Interesting Idea</h3>
            <p class="excerpt">Maybe you're working on a brand. Maybe you have an interesting consumer problem. Maybe you simply want to exchange perspectives. I'm open to conversations.</p>
            <div class="cta-inline"><a href="#connect-form" class="btn-line">Send Me a Message <span class="arrow">→</span></a></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="tight" id="connect-form">
    <div class="container">
      <div class="connect-grid">
        <div class="connect-info reveal">
          <div class="item">
            <span>Email</span>
            <h3><a href="mailto:lalitha2manogna9@gmail.com" class="btn-line">lalitha2manogna9@gmail.com <span class="arrow">→</span></a></h3>
          </div>
          <div class="item">
            <span>LinkedIn</span>
            <h3><a href="https://www.linkedin.com/in/lalitha-manogna-kasturi/" target="_blank" rel="noopener" class="btn-line">View Profile <span class="arrow">→</span></a></h3>
          </div>
          <div class="item">
            <span>Location</span>
            <h3>Singapore</h3>
          </div>
        </div>
        <ConnectForm />
      </div>
    </div>
  </section>
</Layout>
