---
import Layout from '../layouts/Layout.astro';
import ConnectForm from '../components/ConnectForm.astro';
---

<Layout title="Work With Me | Kasturi Lalitha Manogna">
  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Work With Me</span>
        <h1>I'd Love to Hear From You</h1>
        <p>I'm currently building my career in luxury brand management and marketing strategy, with the long term goal of working in global brand strategy for an iconic maison. I'm especially interested in opportunities where I can combine research, strategy, consumer understanding and creative thinking.</p>
      </div>
    </div>
  </section>

  <section class="tight flush-top">
    <div class="container">
      <h2 class="visually-hidden">Ways to get in touch</h2>
      <div class="grid-3">
        <a href="#connect-form" class="card reveal">
          <div class="card-body">
            <h3>Looking for Your Next Luxury Marketer?</h3>
            <p class="excerpt">I'd love to connect if you're looking for someone who is curious about luxury, comfortable with research and analysis, and genuinely interested in understanding consumers and brands.</p>
            <span class="link-arrow card-cta">View My CV <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
        <a href="https://www.linkedin.com/in/lalitha-manogna-kasturi/" target="_blank" rel="noopener" class="card reveal reveal-delay-1">
          <div class="card-body">
            <h3>If You're in the Industry</h3>
            <p class="excerpt">If you work in luxury, marketing, branding, consumer strategy or creative direction, I'm always happy to connect and learn from people in the industry.</p>
            <span class="link-arrow card-cta">Connect on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span> <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
        <a href="#connect-form" class="card reveal reveal-delay-2">
          <div class="card-body">
            <h3>If You Have an Interesting Idea</h3>
            <p class="excerpt">Maybe you're working on a brand. Maybe you have an interesting consumer problem. Maybe you simply want to exchange perspectives. I'm open to conversations.</p>
            <span class="link-arrow card-cta">Send Me a Message <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight" id="connect-form">
    <div class="container">
      <div class="connect-grid">
        <div class="connect-info reveal">
          <h2 class="visually-hidden">Contact details</h2>
          <div class="item">
            <span>Email</span>
            <h3><a href="mailto:lalitha2manogna9@gmail.com" class="btn-line">lalitha2manogna9@gmail.com <span class="arrow" aria-hidden="true">→</span></a></h3>
          </div>
          <div class="item">
            <span>LinkedIn</span>
            <h3><a href="https://www.linkedin.com/in/lalitha-manogna-kasturi/" target="_blank" rel="noopener" class="btn-line">View Profile<span class="visually-hidden"> (opens in a new tab)</span> <span class="arrow" aria-hidden="true">→</span></a></h3>
          </div>
          <div class="item">
            <span>Location</span>
            <h3>Singapore</h3>
          </div>
        </div>
        <ConnectForm />
      </div>
    </div>
  </section>
</Layout>
