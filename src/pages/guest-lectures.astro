---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import TopicFilter from '../components/TopicFilter.astro';
import ExploreMore from '../components/ExploreMore.astro';
import { withBase } from '../lib/url';
import { fetchAllGuestLectures } from '../lib/buildTimeData';
import {
  formatLectureDate,
  lectureCoverImage,
  lectureExcerpt,
  lectureSlugs,
  speakerNames,
  structureLearnings,
} from '../lib/guestLectureTypes';

const lectures = await fetchAllGuestLectures();
const slugs = lectureSlugs(lectures);
const speakerCount = lectures.reduce((n, l) => n + l.speakers.length, 0);
const takeawayCount = lectures.reduce((n, l) => n + structureLearnings(l.key_learnings).points.length, 0);

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w.charAt(0).toUpperCase())
    .join('');
}
---

<Layout title="Guest Lectures | Kasturi Lalitha Manogna"
  description="Notes and key takeaways from guest lectures, the industry voices Kasturi Lalitha Manogna has learned from, with speakers, resources and reflections."
>
  <section class="tight">
    <div class="container">
      <div class="section-head listing-head reveal">
        <span class="eyebrow">Guest Lectures &amp; Industry Voices</span>
        <h1>Voices I've Learned From</h1>
        <p>Notes, quotes and takeaways from the guest speakers who have shaped how I think about luxury and marketing.</p>
      </div>

      {lectures.length > 0 && (
        <dl class="stat-row reveal reveal-delay-1">
          <div><dt>Sessions</dt><dd>{String(lectures.length).padStart(2, '0')}</dd></div>
          <div><dt>Speakers</dt><dd>{String(speakerCount).padStart(2, '0')}</dd></div>
          {takeawayCount > 0 && <div><dt>Key takeaways</dt><dd>{String(takeawayCount).padStart(2, '0')}</dd></div>}
        </dl>
      )}
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Lecture Notes</span>
        <h2>Sessions &amp; Takeaways</h2>
      </div>

      <TopicFilter itemTags={lectures.map((l) => l.tags)} target="lectureList" noun={['lecture', 'lectures']} />

      {lectures.length > 0 ? (
        <div class="feature-list" id="lectureList">
          {lectures.map((lecture, i) => {
            const points = structureLearnings(lecture.key_learnings).points.length;
            return (
              <FeatureCard
                href={withBase(`/guest-lectures/${slugs.get(lecture.id)}/`)}
                kicker="Guest Lecture"
                meta={[formatLectureDate(lecture.lecture_date)]}
                number={`Session ${String(i + 1).padStart(2, '0')}`}
                title={lecture.topic}
                excerpt={lectureExcerpt(lecture, 220)}
                tags={lecture.tags}
                image={lectureCoverImage(lecture) ?? lecture.gallery[0]?.url ?? null}
                imageAlt={`Photo of ${lecture.speakers[0]?.name ?? 'the speaker'}`}
                ctaLabel="Read my notes"
                details={[
                  `${lecture.speakers.length} ${lecture.speakers.length === 1 ? 'speaker' : 'speakers'}`,
                  points > 0 ? `${points} takeaways` : null,
                  lecture.gallery.length > 0 ? `${lecture.gallery.length} ${lecture.gallery.length === 1 ? 'photo' : 'photos'}` : null,
                  lecture.files.length > 0 ? `${lecture.files.length} ${lecture.files.length === 1 ? 'resource' : 'resources'}` : null,
                ]}
                dataTags={lecture.tags}
              >
                <div slot="plate" class="speaker-plate" aria-hidden="true">
                  <span class="brand-plate-label">In Conversation</span>
                  <ul class="speaker-plate-list">
                    {lecture.speakers.slice(0, 4).map((s) => (
                      <li>
                        <span class="speaker-plate-avatar">{initials(s.name)}</span>
                        <span class="speaker-plate-text">
                          <span class="speaker-plate-name">{s.name}</span>
                          {s.role && <span class="speaker-plate-role">{s.role}</span>}
                        </span>
                      </li>
                    ))}
                  </ul>
                  {speakerNames(lecture) && lecture.speakers.length > 4 && <span class="brand-plate-foot">+ {lecture.speakers.length - 4} more</span>}
                </div>
              </FeatureCard>
            );
          })}
        </div>
      ) : (
        <p class="journal-status">No guest lectures yet — check back soon.</p>
      )}
    </div>
  </section>

  <div class="divider"></div>

  <ExploreMore current="guest-lectures" />
</Layout>
