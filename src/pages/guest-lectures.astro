---
import Layout from '../layouts/Layout.astro';
import { fetchAllGuestLectures } from '../lib/buildTimeData';
import { formatLectureDate } from '../lib/guestLectureTypes';

const lectures = await fetchAllGuestLectures();
const lines = (text: string) => text.split('\n').map((l) => l.trim()).filter(Boolean);
---

<Layout title="Guest Lectures | Kasturi Lalitha Manogna">
  <section class="tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Guest Lectures</span>
        <h1>Voices I've Learned From</h1>
        <p>Notes, quotes and takeaways from the guest speakers who have shaped how I think about luxury and marketing.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      {lectures.length === 0 ? (
        <div class="empty-state reveal">
          <p>No guest lectures added yet. This page will grow as I learn from more speakers.</p>
        </div>
      ) : (
        <div class="lecture-list">
          {lectures.map((lecture) => (
            <article class="card lecture-card reveal">
              <div class="card-body">
                <div class="issuer"><span class="date">{formatLectureDate(lecture.lecture_date)}</span></div>
                <h2>{lecture.topic}</h2>

                <div class="lecture-speakers">
                  {lecture.speakers.map((speaker) => (
                    <div class="lecture-speaker">
                      {speaker.photos.length > 0 && (
                        <div class="lecture-photos">
                          {speaker.photos.map((src) => (
                            <img src={src} alt={`Photo of ${speaker.name}`} loading="lazy" />
                          ))}
                        </div>
                      )}
                      <h3>{speaker.name}</h3>
                      {speaker.role && <p class="lecture-role">{speaker.role}</p>}
                      {speaker.description && <p class="excerpt">{speaker.description}</p>}
                      {speaker.quote && <blockquote class="lecture-quote">{speaker.quote}</blockquote>}
                    </div>
                  ))}
                </div>

                <h3 class="lecture-learned-title">What I learned</h3>
                <ul class="excerpt lecture-learned">
                  {lines(lecture.key_learnings).map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>

                {lecture.files.length > 0 && (
                  <div class="lecture-files">
                    {lecture.files.map((file) => (
                      <a class="btn-line" href={file.url} target="_blank" rel="noopener noreferrer">
                        {file.name} <span class="arrow" aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
