---
import Layout from '../../layouts/Layout.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import TopicFilter from '../../components/TopicFilter.astro';
import ExploreMore from '../../components/ExploreMore.astro';
import { withBase } from '../../lib/url';
import { fetchAllPublishedProjects } from '../../lib/buildTimeData';
import type { Project } from '../../lib/projectTypes';

const projects = await fetchAllPublishedProjects();
const completed = projects.filter((p) => p.progress === 'completed');
const building = projects.filter((p) => p.progress === 'in_progress');
const courses = new Set(projects.map((p) => p.course?.toLowerCase()).filter(Boolean)).size;
const teammates = projects.reduce((n, p) => n + p.team.length, 0);

function details(p: Project): (string | null)[] {
  return [
    p.reading_time_minutes ? `${p.reading_time_minutes} min read` : null,
    p.video_url ? 'Video' : null,
    p.gallery.length > 0 ? `${p.gallery.length} ${p.gallery.length === 1 ? 'visual' : 'visuals'}` : null,
    p.pdf_url ? 'Full deck' : null,
  ];
}
---

<Layout
  title="Projects | Kasturi Lalitha Manogna"
  description="University projects by Kasturi Lalitha Manogna — brand strategies, marketing campaigns and research, taken from brief to final pitch."
>
  <section class="tight">
    <div class="container">
      <div class="section-head listing-head reveal">
        <span class="eyebrow">University Projects &amp; Strategic Builds</span>
        <h1>Projects</h1>
        <p>Work from my university courses and beyond — brand strategies, campaigns and research, built with classmates and taken from the first brief to the final pitch.</p>
      </div>

      {projects.length > 0 && (
        <dl class="stat-row reveal reveal-delay-1">
          <div><dt>Projects</dt><dd>{String(projects.length).padStart(2, '0')}</dd></div>
          {courses > 0 && <div><dt>Courses</dt><dd>{String(courses).padStart(2, '0')}</dd></div>}
          {teammates > 0 && <div><dt>Collaborators</dt><dd>{String(teammates).padStart(2, '0')}</dd></div>}
        </dl>
      )}
    </div>
  </section>

  <div class="divider"></div>

  <section class="tight">
    <div class="container">
      {projects.length === 0 ? (
        <div class="empty-state reveal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          <p>The first projects are on their way — check back soon.</p>
        </div>
      ) : (
        <>
          <TopicFilter itemTags={projects.map((p) => p.tags)} target="projectList" noun={['project', 'projects']} />

          <div id="projectList">
            {completed.length > 0 && (
              <div class="feature-list">
                <h2 class="visually-hidden">Completed projects</h2>
                {completed.map((p, i) => (
                  <FeatureCard
                    href={withBase(`/projects/${p.slug}/`)}
                    kicker={p.project_type}
                    meta={[p.course, p.period]}
                    number={`Project ${String(i + 1).padStart(2, '0')}${p.institution ? ` · ${p.institution}` : ''}`}
                    title={p.title}
                    excerpt={p.excerpt}
                    tags={p.tags}
                    image={p.cover_image ?? p.gallery[0]?.url ?? null}
                    ctaLabel="Explore the project"
                    details={details(p)}
                    dataTags={p.tags}
                    reverse
                  >
                    <div slot="plate" class="brand-plate" aria-hidden="true">
                      <span class="brand-plate-label">Project · {String(i + 1).padStart(2, '0')}</span>
                      <span class="brand-plate-name project-plate-name">{p.title.split(/[:—–]/)[0]}</span>
                      <span class="brand-plate-rule"></span>
                      <span class="brand-plate-foot">{[p.course, p.institution].filter(Boolean).join(' · ')}</span>
                    </div>
                  </FeatureCard>
                ))}
              </div>
            )}

            {building.length > 0 && (
              <div class="building">
                <div class="building-head reveal">
                  <h2>Currently Building</h2>
                  <span class="building-status"><span class="building-dot" aria-hidden="true"></span>In active development</span>
                </div>
                <div class="building-grid">
                  {building.map((p, i) => (
                    <a href={withBase(`/projects/${p.slug}/`)} class={`building-card reveal ${i % 2 === 1 ? 'reveal-delay-1' : ''}`} data-tags={JSON.stringify(p.tags)}>
                      <div class="building-card-top">
                        <span class="building-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"></path><circle cx="12" cy="12" r="3.2"></circle></svg>
                        </span>
                        <span class="pill">{p.project_type ?? 'In progress'}</span>
                      </div>
                      <h3>{p.title}</h3>
                      <p>{p.excerpt}</p>
                      {(p.course || p.period) && <span class="building-meta">{[p.course, p.period].filter(Boolean).join(' · ')}</span>}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </>
      )}
    </div>
  </section>

  <div class="divider"></div>

  <ExploreMore current="projects" />
</Layout>
