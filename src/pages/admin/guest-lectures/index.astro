---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { withBase } from '../../../lib/url';
---

<AdminLayout title="Guest Lectures">
  <div class="admin-section-head">
    <div>
      <h1>Guest Lectures</h1>
      <p class="admin-lede" style="margin-bottom:0;">What I learned from each guest lecture — shown newest first on the public Guest Lectures page.</p>
    </div>
    <a href={withBase('/admin/guest-lectures/new/')} class="btn-solid">New Lecture</a>
  </div>

  <div class="admin-toolbar">
    <input type="search" id="searchInput" placeholder="Search by topic or speaker…" aria-label="Search guest lectures" />
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>Date</th><th>Topic</th><th>Speakers</th><th>Files</th><th></th></tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="5" class="admin-empty">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import { listAllGuestLectures, deleteGuestLecture, deleteGuestLectureAssets } from '../../../lib/supabaseAdmin';
    import { withBase } from '../../../lib/url';
    import { escapeHtml } from '../../../lib/html';
    import { showToast } from '../../../lib/toast';
    import { formatLectureDate } from '../../../lib/guestLectureTypes';
    import type { GuestLecture } from '../../../lib/guestLectureTypes';

    let all: GuestLecture[] = [];

    const rows = document.getElementById('rows')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;

    function render() {
      const query = searchInput.value.trim().toLowerCase();
      const filtered = all.filter(
        (item) =>
          !query ||
          item.topic.toLowerCase().includes(query) ||
          item.speakers.some((s) => s.name.toLowerCase().includes(query))
      );

      if (filtered.length === 0) {
        rows.innerHTML = `<tr><td colspan="5" class="admin-empty">${all.length === 0 ? 'No guest lectures yet.' : 'No matching lectures.'}</td></tr>`;
        return;
      }

      rows.innerHTML = filtered
        .map((item) => {
          const editHref = withBase(`/admin/guest-lectures/edit/?id=${item.id}`);
          const speakers = item.speakers.map((s) => escapeHtml(s.name)).join(', ') || '—';
          return `
        <tr data-id="${item.id}">
          <td>${escapeHtml(formatLectureDate(item.lecture_date))}</td>
          <td class="title-cell"><a href="${editHref}">${escapeHtml(item.topic)}</a></td>
          <td>${speakers}</td>
          <td>${item.files.length || '—'}</td>
          <td class="actions-cell">
            <a href="${editHref}">Edit</a>
            <button type="button" class="danger delete-btn" data-id="${item.id}" data-title="${escapeHtml(item.topic)}">Delete</button>
          </td>
        </tr>`;
        })
        .join('');
    }

    async function load() {
      try {
        all = await listAllGuestLectures();
        render();
      } catch (err) {
        rows.innerHTML = `<tr><td colspan="5" class="admin-empty">${escapeHtml(err instanceof Error ? err.message : 'Failed to load.')}</td></tr>`;
      }
    }

    rows.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.delete-btn') as HTMLButtonElement | null;
      if (!btn) return;
      const id = btn.dataset.id!;
      const title = btn.dataset.title!;
      if (!confirm(`Delete "${title}"? Its photos and files are removed too. This cannot be undone.`)) return;
      btn.disabled = true;
      try {
        const lecture = all.find((l) => l.id === id);
        await deleteGuestLecture(id);
        if (lecture) {
          await deleteGuestLectureAssets([...lecture.speakers.flatMap((s) => s.photos), ...lecture.files.map((f) => f.url)]);
        }
        all = all.filter((item) => item.id !== id);
        render();
        showToast('Lecture deleted.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Failed to delete.', 'error');
        btn.disabled = false;
      }
    });

    searchInput.addEventListener('input', render);
    document.addEventListener('admin:ready', load);
  </script>
</AdminLayout>
