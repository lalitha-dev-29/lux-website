---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CaseStudyFormFields from '../../../components/admin/CaseStudyFormFields.astro';
import { withBase } from '../../../lib/url';
---

<AdminLayout title="New Case Study">
  <h1>New Case Study</h1>
  <p class="admin-lede">Save as a draft to keep working, or publish right away. You can attach a PDF after saving.</p>

  <form class="admin-form" id="caseStudyForm" novalidate>
    <CaseStudyFormFields />

    <div aria-live="polite" aria-atomic="true">
      <p class="form-error" id="formError" hidden></p>
    </div>

    <div class="admin-form-actions">
      <a href={withBase('/admin/case-studies/')} class="btn-line">Cancel</a>
      <div class="spacer"></div>
      <button type="button" class="btn-line" id="saveDraftBtn">Save Draft</button>
      <button type="button" class="btn-solid" id="publishBtn">Publish</button>
    </div>
  </form>

  <script>
    import { createCaseStudy } from '../../../lib/supabaseAdmin';
    import { readCaseStudyForm, validateCaseStudyForm, toCaseStudyInput } from '../../../lib/caseStudyForm';
    import { withBase } from '../../../lib/url';
    import { wireContentFormImages } from '../../../lib/imageUpload';
    import { initLinksEditor } from '../../../lib/linksForm';
    import { showToast } from '../../../lib/toast';

    const form = document.getElementById('caseStudyForm') as HTMLFormElement;
    const errorEl = document.getElementById('formError') as HTMLParagraphElement;
    const draftBtn = document.getElementById('saveDraftBtn') as HTMLButtonElement;
    const publishBtn = document.getElementById('publishBtn') as HTMLButtonElement;

    const draftId = crypto.randomUUID();
    wireContentFormImages(`case-studies/${draftId}`);
    initLinksEditor('caseStudyLinks');

    let dirty = false;
    form.addEventListener('input', () => {
      dirty = true;
    });
    window.addEventListener('beforeunload', (e) => {
      if (dirty) e.preventDefault();
    });

    async function submit(status: 'draft' | 'published') {
      errorEl.hidden = true;
      const values = readCaseStudyForm();
      const validationError = validateCaseStudyForm(values);
      if (validationError) {
        errorEl.textContent = validationError;
        errorEl.hidden = false;
        return;
      }

      draftBtn.disabled = true;
      publishBtn.disabled = true;
      const busyBtn = status === 'draft' ? draftBtn : publishBtn;
      const originalLabel = busyBtn.textContent;
      busyBtn.textContent = 'Saving…';

      try {
        const entry = await createCaseStudy(toCaseStudyInput(values), status);
        dirty = false;
        showToast(status === 'published' ? 'Case study published.' : 'Draft saved.');
        window.location.href = withBase(`/admin/case-studies/edit/?id=${entry.id}`);
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : 'Failed to save.';
        errorEl.hidden = false;
        draftBtn.disabled = false;
        publishBtn.disabled = false;
        busyBtn.textContent = originalLabel;
      }
    }

    draftBtn.addEventListener('click', () => submit('draft'));
    publishBtn.addEventListener('click', () => submit('published'));
  </script>
</AdminLayout>
