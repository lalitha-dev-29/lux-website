---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { withBase } from '../../lib/url';
---

<AdminLayout title="Dashboard">
  <h1>Dashboard</h1>
  <p class="admin-lede">A quick look at Journal content.</p>

  <div class="admin-stats" id="statsGrid">
    <div class="admin-stat"><span class="num" id="statTotal">—</span><span class="label">Total Posts</span></div>
    <div class="admin-stat"><span class="num" id="statPublished">—</span><span class="label">Published</span></div>
    <div class="admin-stat"><span class="num" id="statDraft">—</span><span class="label">Drafts</span></div>
  </div>

  <div class="admin-section-head">
    <h2>Recently Updated</h2>
    <a href={withBase('/admin/journal/')} class="btn-line">View All Journal<span class="arrow" aria-hidden="true">→</span></a>
  </div>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>Title</th><th>Status</th><th>Updated</th></tr>
      </thead>
      <tbody id="recentRows">
        <tr><td colspan="3" class="admin-empty">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import { listAllJournalPosts } from '../../lib/supabaseAdmin';
    import { withBase } from '../../lib/url';
    import { escapeHtml } from '../../lib/html';

    document.addEventListener('admin:ready', async () => {
      const rows = document.getElementById('recentRows')!;
      try {
        const posts = await listAllJournalPosts();
        document.getElementById('statTotal')!.textContent = String(posts.length);
        document.getElementById('statPublished')!.textContent = String(posts.filter((p) => p.status === 'published').length);
        document.getElementById('statDraft')!.textContent = String(posts.filter((p) => p.status === 'draft').length);

        const recent = posts.slice(0, 5);
        if (recent.length === 0) {
          rows.innerHTML = '<tr><td colspan="3" class="admin-empty">No Journal posts yet.</td></tr>';
          return;
        }
        rows.innerHTML = recent
          .map(
            (p) => `
          <tr>
            <td class="title-cell"><a href="${withBase(`/admin/journal/edit/?id=${p.id}`)}">${escapeHtml(p.title)}</a></td>
            <td><span class="badge badge-${p.status}">${p.status}</span></td>
            <td>${new Date(p.updated_at).toLocaleDateString()}</td>
          </tr>`
          )
          .join('');
      } catch (err) {
        rows.innerHTML = `<tr><td colspan="3" class="admin-empty">${escapeHtml(err instanceof Error ? err.message : 'Failed to load.')}</td></tr>`;
      }
    });
  </script>
</AdminLayout>
