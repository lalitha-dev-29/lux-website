---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import LearningSubNav from '../../../../components/admin/LearningSubNav.astro';
import { withBase } from '../../../../lib/url';
---

<AdminLayout title="Learning — Certifications">
  <h1>Learning</h1>
  <p class="admin-lede">Manage the Learning page's introduction, Right Now topics, Education history and Certifications.</p>
  <LearningSubNav />

  <div class="admin-section-head">
    <div>
      <h2>Certifications</h2>
      <p class="admin-lede" style="margin-bottom:0;">Courses &amp; credentials shown on the public page.</p>
    </div>
    <a href={withBase('/admin/learning/certifications/new/')} class="btn-solid">New Certificate</a>
  </div>

  <div class="admin-toolbar">
    <input type="search" id="searchInput" placeholder="Search by name or institution…" aria-label="Search Certifications" />
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>Order</th><th></th><th>Name</th><th>Institution</th><th>Date</th><th>Credential ID</th><th></th></tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="7" class="admin-empty">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import { listAllCertifications, deleteCertification, deleteCertificateFileObject, reorderCertifications } from '../../../../lib/supabaseAdmin';
    import { withBase } from '../../../../lib/url';
    import { escapeHtml, safeUrl } from '../../../../lib/html';
    import { showToast } from '../../../../lib/toast';
    import { formatCertDate, type LearningCertification } from '../../../../lib/learningTypes';

    let all: LearningCertification[] = [];

    const rows = document.getElementById('rows')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;

    function thumbCell(item: LearningCertification): string {
      if (item.file_type === 'image') {
        return `<a href="${safeUrl(item.file_url)}" target="_blank" rel="noopener"><img src="${safeUrl(item.file_url)}" alt="" class="cert-thumb" /></a>`;
      }
      return `<a href="${safeUrl(item.file_url)}" target="_blank" rel="noopener" class="cert-thumb cert-thumb-pdf" aria-label="Open PDF">PDF</a>`;
    }

    function render() {
      const query = searchInput.value.trim().toLowerCase();
      const filtered = all.filter(
        (item) =>
          !query ||
          item.name.toLowerCase().includes(query) ||
          item.issuing_institution.toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        rows.innerHTML = `<tr><td colspan="7" class="admin-empty">${all.length === 0 ? 'No certificates yet.' : 'No matching certificates.'}</td></tr>`;
        return;
      }

      rows.innerHTML = filtered
        .map(
          (item, i) => `
        <tr data-id="${item.id}">
          <td class="reorder-cell">
            <button type="button" class="move-up-btn" data-id="${item.id}" aria-label="Move up" ${i === 0 ? 'disabled' : ''}>↑</button>
            <button type="button" class="move-down-btn" data-id="${item.id}" aria-label="Move down" ${i === filtered.length - 1 ? 'disabled' : ''}>↓</button>
          </td>
          <td>${thumbCell(item)}</td>
          <td class="title-cell"><a href="${withBase(`/admin/learning/certifications/edit/?id=${item.id}`)}">${escapeHtml(item.name)}</a></td>
          <td>${escapeHtml(item.issuing_institution)}</td>
          <td>${escapeHtml(formatCertDate(item))}</td>
          <td><code>${escapeHtml(item.credential_id)}</code></td>
          <td class="actions-cell">
            <a href="${safeUrl(item.certificate_link)}" target="_blank" rel="noopener">View</a>
            <a href="${withBase(`/admin/learning/certifications/edit/?id=${item.id}`)}">Edit</a>
            <button type="button" class="danger delete-btn" data-id="${item.id}" data-name="${escapeHtml(item.name)}">Delete</button>
          </td>
        </tr>`
        )
        .join('');
    }

    async function load() {
      try {
        all = await listAllCertifications();
        render();
      } catch (err) {
        rows.innerHTML = `<tr><td colspan="7" class="admin-empty">${escapeHtml(err instanceof Error ? err.message : 'Failed to load.')}</td></tr>`;
      }
    }

    async function persistReorder() {
      try {
        await reorderCertifications(all.map((item) => item.id));
        showToast('Order updated.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Failed to reorder.', 'error');
      }
    }

    rows.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;

      const upBtn = target.closest('.move-up-btn') as HTMLButtonElement | null;
      const downBtn = target.closest('.move-down-btn') as HTMLButtonElement | null;
      if (upBtn || downBtn) {
        const id = (upBtn || downBtn)!.dataset.id!;
        const idx = all.findIndex((item) => item.id === id);
        const swapWith = upBtn ? idx - 1 : idx + 1;
        if (idx === -1 || swapWith < 0 || swapWith >= all.length) return;
        [all[idx], all[swapWith]] = [all[swapWith], all[idx]];
        render();
        await persistReorder();
        return;
      }

      const deleteBtn = target.closest('.delete-btn') as HTMLButtonElement | null;
      if (deleteBtn) {
        const id = deleteBtn.dataset.id!;
        const name = deleteBtn.dataset.name!;
        if (!confirm(`Delete "${name}"? This will remove the certificate from the Learning section. This cannot be undone.`)) return;
        deleteBtn.disabled = true;
        try {
          const item = all.find((c) => c.id === id);
          await deleteCertification(id);
          if (item) await deleteCertificateFileObject(item.file_url);
          all = all.filter((c) => c.id !== id);
          render();
          showToast('Certificate deleted successfully.');
        } catch (err) {
          showToast(err instanceof Error ? err.message : 'Failed to delete.', 'error');
          deleteBtn.disabled = false;
        }
      }
    });

    searchInput.addEventListener('input', render);

    document.addEventListener('admin:ready', load);
  </script>
</AdminLayout>
