---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import LearningSubNav from '../../../../components/admin/LearningSubNav.astro';
import { withBase } from '../../../../lib/url';
---

<AdminLayout title="Learning — Guest Lectures">
  <h1>Learning</h1>
  <p class="admin-lede">Manage the Learning page's introduction, Right Now topics, Guest Lectures, Education history and Certifications.</p>
  <LearningSubNav />

  <div class="admin-section-head">
    <div>
      <h2>Guest Lectures</h2>
      <p class="admin-lede" style="margin-bottom:0;">What I learned from each guest lecture — shown newest first on the public page.</p>
    </div>
    <a href={withBase('/admin/learning/guest-lectures/new/')} class="btn-solid">New Lecture</a>
  </div>

  <div class="admin-toolbar">
    <input type="search" id="searchInput" placeholder="Search by title or speaker…" aria-label="Search guest lectures" />
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>Date</th><th>Lecture</th><th>Speaker</th><th>What I learned</th><th></th></tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="5" class="admin-empty">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import { listAllGuestLectures, deleteGuestLecture } from '../../../../lib/supabaseAdmin';
    import { withBase } from '../../../../lib/url';
    import { escapeHtml } from '../../../../lib/html';
    import { showToast } from '../../../../lib/toast';
    import { formatLectureDate } from '../../../../lib/learningTypes';
    import type { LearningGuestLecture } from '../../../../lib/learningTypes';

    let all: LearningGuestLecture[] = [];

    const rows = document.getElementById('rows')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;

    function render() {
      const query = searchInput.value.trim().toLowerCase();
      const filtered = all.filter(
        (item) =>
          !query ||
          item.title.toLowerCase().includes(query) ||
          item.speaker.toLowerCase().includes(query) ||
          (item.organisation ?? '').toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        rows.innerHTML = `<tr><td colspan="5" class="admin-empty">${all.length === 0 ? 'No guest lectures yet.' : 'No matching lectures.'}</td></tr>`;
        return;
      }

      rows.innerHTML = filtered
        .map(
          (item) => `
        <tr data-id="${item.id}">
          <td>${escapeHtml(formatLectureDate(item.lecture_date))}</td>
          <td class="title-cell"><a href="${withBase(`/admin/learning/guest-lectures/edit/?id=${item.id}`)}">${escapeHtml(item.title)}</a></td>
          <td>${escapeHtml(item.speaker)}${item.organisation ? `<br><small>${escapeHtml(item.organisation)}</small>` : ''}</td>
          <td>${escapeHtml(item.key_learnings.slice(0, 90))}${item.key_learnings.length > 90 ? '…' : ''}</td>
          <td class="actions-cell">
            <a href="${withBase(`/admin/learning/guest-lectures/edit/?id=${item.id}`)}">Edit</a>
            <button type="button" class="danger delete-btn" data-id="${item.id}" data-title="${escapeHtml(item.title)}">Delete</button>
          </td>
        </tr>`
        )
        .join('');
    }

    async function load() {
      try {
        all = await listAllGuestLectures();
        render();
      } catch (err) {
        rows.innerHTML = `<tr><td colspan="5" class="admin-empty">${escapeHtml(err instanceof Error ? err.message : 'Failed to load.')}</td></tr>`;
      }
    }

    rows.addEventListener('click', async (e) => {
      const deleteBtn = (e.target as HTMLElement).closest('.delete-btn') as HTMLButtonElement | null;
      if (!deleteBtn) return;
      const id = deleteBtn.dataset.id!;
      const title = deleteBtn.dataset.title!;
      if (!confirm(`Delete "${title}"? This will remove it from the Learning section. This cannot be undone.`)) return;
      deleteBtn.disabled = true;
      try {
        await deleteGuestLecture(id);
        all = all.filter((item) => item.id !== id);
        render();
        showToast('Lecture deleted.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Failed to delete.', 'error');
        deleteBtn.disabled = false;
      }
    });

    searchInput.addEventListener('input', render);

    document.addEventListener('admin:ready', load);
  </script>
</AdminLayout>
