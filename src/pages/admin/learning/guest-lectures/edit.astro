---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import LearningSubNav from '../../../../components/admin/LearningSubNav.astro';
import GuestLectureFormFields from '../../../../components/admin/GuestLectureFormFields.astro';
import { withBase } from '../../../../lib/url';
---

<AdminLayout title="Edit Guest Lecture">
  <h1>Learning</h1>
  <LearningSubNav />
  <h2>Edit Guest Lecture</h2>

  <form class="admin-form" id="guestLectureForm" novalidate hidden>
    <GuestLectureFormFields />

    <div aria-live="polite" aria-atomic="true">
      <p class="form-error" id="formError" hidden></p>
    </div>

    <div class="admin-form-actions">
      <a href={withBase('/admin/learning/guest-lectures/')} class="btn-line">Back to Guest Lectures</a>
      <div class="spacer"></div>
      <button type="button" class="btn-solid" id="saveBtn">Save Changes</button>
    </div>

    <div class="admin-danger-zone">
      <h2>Danger Zone</h2>
      <button type="button" class="btn-line" id="deleteBtn">Delete This Lecture</button>
    </div>
  </form>

  <p class="admin-empty" id="loadError" hidden></p>

  <script>
    import { getGuestLectureById, updateGuestLecture, deleteGuestLecture } from '../../../../lib/supabaseAdmin';
    import { readGuestLectureForm, writeGuestLectureForm, validateGuestLectureForm, toGuestLectureInput } from '../../../../lib/guestLectureForm';
    import { withBase } from '../../../../lib/url';
    import { showToast } from '../../../../lib/toast';
    import type { LearningGuestLecture } from '../../../../lib/learningTypes';

    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');

    const form = document.getElementById('guestLectureForm') as HTMLFormElement;
    const loadError = document.getElementById('loadError')!;
    const errorEl = document.getElementById('formError') as HTMLParagraphElement;
    const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
    const deleteBtn = document.getElementById('deleteBtn') as HTMLButtonElement;

    let current: LearningGuestLecture | null = null;
    let dirty = false;

    async function load() {
      if (!id) {
        loadError.textContent = 'No lecture specified.';
        loadError.hidden = false;
        return;
      }
      try {
        const entry = await getGuestLectureById(id);
        if (!entry) {
          loadError.textContent = 'Lecture not found.';
          loadError.hidden = false;
          return;
        }
        current = entry;
        writeGuestLectureForm(entry);
        form.hidden = false;
      } catch (err) {
        loadError.textContent = err instanceof Error ? err.message : 'Failed to load lecture.';
        loadError.hidden = false;
      }
    }

    form.addEventListener('input', () => {
      dirty = true;
    });
    window.addEventListener('beforeunload', (e) => {
      if (dirty) e.preventDefault();
    });

    saveBtn.addEventListener('click', async () => {
      if (!current) return;
      errorEl.hidden = true;
      const values = readGuestLectureForm();
      const validationError = validateGuestLectureForm(values);
      if (validationError) {
        errorEl.textContent = validationError;
        errorEl.hidden = false;
        return;
      }
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      try {
        current = await updateGuestLecture(current.id, toGuestLectureInput(values));
        dirty = false;
        showToast('Lecture updated successfully.');
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : 'Failed to save.';
        errorEl.hidden = false;
        showToast('Failed to update lecture.', 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    });

    deleteBtn.addEventListener('click', async () => {
      if (!current) return;
      if (!confirm(`Delete "${current.title}"? This will remove it from the Learning section. This cannot be undone.`)) return;
      deleteBtn.disabled = true;
      try {
        await deleteGuestLecture(current.id);
        dirty = false;
        showToast('Lecture deleted successfully.');
        window.location.href = withBase('/admin/learning/guest-lectures/');
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : 'Failed to delete.';
        errorEl.hidden = false;
        deleteBtn.disabled = false;
      }
    });

    document.addEventListener('admin:ready', load);
  </script>
</AdminLayout>
