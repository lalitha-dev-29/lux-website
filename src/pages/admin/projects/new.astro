---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProjectFormFields from '../../../components/admin/ProjectFormFields.astro';
import { withBase } from '../../../lib/url';
---

<AdminLayout title="New Project">
  <h1>New Project</h1>
  <p class="admin-lede">Only the title and summary are required — fill in as much or as little as you like. You can attach the final deck or report (PDF) after saving.</p>

  <form class="admin-form" id="projectForm" novalidate>
    <ProjectFormFields />

    <div aria-live="polite" aria-atomic="true">
      <p class="form-error" id="formError" hidden></p>
    </div>

    <div class="admin-form-actions">
      <a href={withBase('/admin/projects/')} class="btn-line">Cancel</a>
      <div class="spacer"></div>
      <button type="button" class="btn-line" id="saveDraftBtn">Save Draft</button>
      <button type="button" class="btn-solid" id="publishBtn">Publish</button>
    </div>
  </form>

  <script>
    import { createProject, uploadContentImage } from '../../../lib/supabaseAdmin';
    import { validateProjectForm, toProjectInput } from '../../../lib/projectForm';
    import { initGalleryEditor } from '../../../lib/galleryEditor';
    import { wireSingleImageField, wireInlineImageInsert } from '../../../lib/imageUpload';
    import { initLinksEditor } from '../../../lib/linksForm';
    import { withBase } from '../../../lib/url';
    import { showToast } from '../../../lib/toast';

    const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const form = byId<HTMLFormElement>('projectForm');
    const errorEl = byId<HTMLParagraphElement>('formError');
    const draftBtn = byId<HTMLButtonElement>('saveDraftBtn');
    const publishBtn = byId<HTMLButtonElement>('publishBtn');

    // The id is chosen up front so uploads are filed under the project's own folder.
    const projectId = crypto.randomUUID();
    const prefix = `projects/${projectId}`;
    wireSingleImageField(prefix, {
      fileInput: byId('fCoverImageFile'),
      hiddenInput: byId('fCoverImage'),
      preview: byId('fCoverImagePreview'),
      removeBtn: byId('fCoverImageRemove'),
      status: byId('fCoverImageStatus'),
    });
    wireInlineImageInsert(prefix, byId('fContent'), byId('fContentImageFile'), byId('contentImageStatus'), byId('insertImageBtn'));
    initLinksEditor('projectLinks');

    let dirty = false;
    form.addEventListener('input', () => {
      dirty = true;
    });
    window.addEventListener('beforeunload', (e) => {
      if (dirty) e.preventDefault();
    });
    const gallery = initGalleryEditor('projectGallery');
    gallery.onChange(() => {
      dirty = true;
    });

    async function submit(status: 'draft' | 'published') {
      errorEl.hidden = true;
      const problem = validateProjectForm();
      if (problem) {
        errorEl.textContent = problem;
        errorEl.hidden = false;
        return;
      }
      draftBtn.disabled = true;
      publishBtn.disabled = true;
      const busyBtn = status === 'draft' ? draftBtn : publishBtn;
      const label = busyBtn.textContent;
      busyBtn.textContent = 'Saving…';
      try {
        const images = await gallery.resolve((file) => uploadContentImage(`${prefix}/gallery`, file));
        const entry = await createProject(toProjectInput(images), status, projectId);
        dirty = false;
        showToast(status === 'published' ? 'Project published.' : 'Draft saved.');
        window.location.href = withBase(`/admin/projects/edit/?id=${entry.id}`);
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : 'Failed to save.';
        errorEl.hidden = false;
        draftBtn.disabled = false;
        publishBtn.disabled = false;
        busyBtn.textContent = label;
      }
    }

    draftBtn.addEventListener('click', () => submit('draft'));
    publishBtn.addEventListener('click', () => submit('published'));
  </script>
</AdminLayout>
