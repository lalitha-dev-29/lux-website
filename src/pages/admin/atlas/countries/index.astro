---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AtlasSubNav from '../../../../components/admin/AtlasSubNav.astro';
import { withBase } from '../../../../lib/url';
---

<AdminLayout title="Atlas — Countries">
  <h1>Atlas</h1>
  <p class="admin-lede">Manage the countries, brands and research that appear in The Luxury Atlas.</p>
  <AtlasSubNav />

  <div class="admin-section-head">
    <div>
      <h2>Countries</h2>
      <p class="admin-lede" style="margin-bottom:0;">Publish a country to make it interactive on the public map.</p>
    </div>
    <a href={withBase('/admin/atlas/countries/new/')} class="btn-solid">+ Add Country</a>
  </div>

  <div class="admin-toolbar">
    <input type="search" id="searchInput" placeholder="Search by name or map identifier…" aria-label="Search Countries" />
    <select id="statusFilter" aria-label="Filter by status">
      <option value="all">All statuses</option>
      <option value="published">Published</option>
      <option value="draft">Draft</option>
      <option value="unpublished">Unpublished</option>
    </select>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>Order</th><th>Country</th><th>Map Identifier</th><th>Status</th><th>Brands</th><th>Updated</th><th></th></tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="7" class="admin-empty">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import {
      listAllAtlasCountries,
      listAllAtlasBrands,
      setAtlasCountryStatus,
      deleteAtlasCountry,
      duplicateAtlasCountry,
      reorderAtlasCountries,
    } from '../../../../lib/supabaseAdmin';
    import { withBase } from '../../../../lib/url';
    import { escapeHtml } from '../../../../lib/html';
    import { countryFlagEmoji } from '../../../../lib/flagEmoji';
    import { showToast } from '../../../../lib/toast';
    import type { AtlasCountry, AtlasCountryStatus } from '../../../../lib/atlasTypes';

    let all: AtlasCountry[] = [];
    let brandCounts = new Map<string, number>();

    const rows = document.getElementById('rows')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;

    function render() {
      const query = searchInput.value.trim().toLowerCase();
      const status = statusFilter.value;
      const filtered = all.filter((c) => {
        const matchesStatus = status === 'all' || c.status === status;
        const matchesQuery =
          !query || c.name.toLowerCase().includes(query) || (c.map_id ?? '').toLowerCase().includes(query);
        return matchesStatus && matchesQuery;
      });

      if (filtered.length === 0) {
        rows.innerHTML =
          all.length === 0
            ? `<tr><td colspan="7" class="admin-empty">Your Atlas is empty. Start by adding the first country and its research. <br /><a class="btn-line" style="margin-top:var(--sp-3); display:inline-block;" href="${withBase('/admin/atlas/countries/new/')}">+ Add Country</a></td></tr>`
            : '<tr><td colspan="7" class="admin-empty">No matching countries.</td></tr>';
        return;
      }

      rows.innerHTML = filtered
        .map((c, i) => {
          const flag = countryFlagEmoji(c.country_code);
          return `
        <tr data-id="${c.id}">
          <td class="reorder-cell">
            <button type="button" class="move-up-btn" data-id="${c.id}" aria-label="Move up" ${i === 0 ? 'disabled' : ''}>↑</button>
            <button type="button" class="move-down-btn" data-id="${c.id}" aria-label="Move down" ${i === filtered.length - 1 ? 'disabled' : ''}>↓</button>
          </td>
          <td class="title-cell"><a href="${withBase(`/admin/atlas/countries/edit/?id=${c.id}`)}">${flag ? flag + ' ' : ''}${escapeHtml(c.name)}</a>${c.is_featured ? ' <span class="badge badge-featured">Featured</span>' : ''}</td>
          <td>${c.map_id ? escapeHtml(c.map_id) : '<span class="hint">Not linked</span>'}</td>
          <td>
            <select class="status-select" data-id="${c.id}" aria-label="Status for ${escapeHtml(c.name)}">
              <option value="draft" ${c.status === 'draft' ? 'selected' : ''}>Draft</option>
              <option value="published" ${c.status === 'published' ? 'selected' : ''}>Published</option>
              <option value="unpublished" ${c.status === 'unpublished' ? 'selected' : ''}>Unpublished</option>
            </select>
          </td>
          <td>${brandCounts.get(c.id) ?? 0}</td>
          <td>${new Date(c.updated_at).toLocaleDateString()}</td>
          <td class="actions-cell">
            <a href="${withBase(`/admin/atlas/countries/edit/?id=${c.id}`)}">Edit</a>
            <button type="button" class="duplicate-btn" data-id="${c.id}">Duplicate</button>
            <button type="button" class="danger delete-btn" data-id="${c.id}" data-name="${escapeHtml(c.name)}">Delete</button>
          </td>
        </tr>`;
        })
        .join('');
    }

    async function load() {
      try {
        const [countries, brands] = await Promise.all([listAllAtlasCountries(), listAllAtlasBrands()]);
        all = countries;
        brandCounts = new Map();
        for (const b of brands) {
          brandCounts.set(b.country_id, (brandCounts.get(b.country_id) ?? 0) + 1);
        }
        render();
      } catch (err) {
        rows.innerHTML = `<tr><td colspan="7" class="admin-empty">${escapeHtml(err instanceof Error ? err.message : 'Failed to load.')}</td></tr>`;
      }
    }

    async function persistReorder() {
      try {
        await reorderAtlasCountries(all.map((c) => c.id));
        showToast('Order updated.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Failed to reorder.', 'error');
      }
    }

    rows.addEventListener('change', async (e) => {
      const select = (e.target as HTMLElement).closest('.status-select') as HTMLSelectElement | null;
      if (!select) return;
      const id = select.dataset.id!;
      const next = select.value as AtlasCountryStatus;
      select.disabled = true;
      try {
        const updated = await setAtlasCountryStatus(id, next);
        all = all.map((c) => (c.id === id ? updated : c));
        render();
        showToast(
          next === 'published' ? 'Country published.' : next === 'unpublished' ? 'Country unpublished.' : 'Country set to draft.'
        );
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'Failed to update status.', 'error');
        select.disabled = false;
        render();
      }
    });

    rows.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;

      const upBtn = target.closest('.move-up-btn') as HTMLButtonElement | null;
      const downBtn = target.closest('.move-down-btn') as HTMLButtonElement | null;
      if (upBtn || downBtn) {
        const id = (upBtn || downBtn)!.dataset.id!;
        const idx = all.findIndex((c) => c.id === id);
        const swapWith = upBtn ? idx - 1 : idx + 1;
        if (idx === -1 || swapWith < 0 || swapWith >= all.length) return;
        [all[idx], all[swapWith]] = [all[swapWith], all[idx]];
        render();
        await persistReorder();
        return;
      }

      const duplicateBtn = target.closest('.duplicate-btn') as HTMLButtonElement | null;
      if (duplicateBtn) {
        const id = duplicateBtn.dataset.id!;
        duplicateBtn.disabled = true;
        try {
          const copy = await duplicateAtlasCountry(id);
          showToast('Country duplicated as a new draft.');
          window.location.href = withBase(`/admin/atlas/countries/edit/?id=${copy.id}`);
        } catch (err) {
          showToast(err instanceof Error ? err.message : 'Failed to duplicate.', 'error');
          duplicateBtn.disabled = false;
        }
        return;
      }

      const deleteBtn = target.closest('.delete-btn') as HTMLButtonElement | null;
      if (deleteBtn) {
        const id = deleteBtn.dataset.id!;
        const name = deleteBtn.dataset.name!;
        const count = brandCounts.get(id) ?? 0;
        const warning = count > 0 ? `This country has ${count} brand${count === 1 ? '' : 's'} — deleting it will also delete them. ` : '';
        if (!confirm(`${warning}Delete "${name}"? This cannot be undone.`)) return;
        deleteBtn.disabled = true;
        try {
          await deleteAtlasCountry(id);
          all = all.filter((c) => c.id !== id);
          render();
          showToast('Country deleted.');
        } catch (err) {
          showToast(err instanceof Error ? err.message : 'Failed to delete.', 'error');
          deleteBtn.disabled = false;
        }
      }
    });

    searchInput.addEventListener('input', render);
    statusFilter.addEventListener('change', render);

    document.addEventListener('admin:ready', load);
  </script>
</AdminLayout>
