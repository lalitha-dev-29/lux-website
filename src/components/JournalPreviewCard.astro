---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'journal'>;
  revealClass?: string;
}

const { entry, revealClass = '' } = Astro.props;
const p = entry.data;
---

<a href={p.url} target="_blank" rel="noopener" class={`card reveal ${revealClass}`}>
  <div class="card-body">
    <div class="card-meta">LinkedIn Post</div>
    <h3>{p.title}</h3>
    <p class="excerpt">{p.excerpt}</p>
  </div>
</a>
