---
import { withBase } from '../lib/url';
import ContentCard from './ContentCard.astro';
import type { CaseStudy } from '../lib/caseStudyTypes';

interface Props {
  entry: CaseStudy;
  revealClass?: string;
}

const { entry: c, revealClass = '' } = Astro.props;
const readingLabel = c.reading_time_minutes ? `${c.reading_time_minutes} min read` : null;
---

<ContentCard
  href={withBase(`/case-studies/${c.slug}/`)}
  eyebrow={c.category}
  meta={readingLabel}
  title={c.title}
  excerpt={c.excerpt}
  tags={c.tags}
  image={c.cover_image}
  ctaLabel="Read case study"
  featured={c.featured}
  badge="Coming Soon"
  revealClass={revealClass}
/>
