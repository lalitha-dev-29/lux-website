---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'journal'>;
  revealClass?: string;
}

const { entry, revealClass = '' } = Astro.props;
const p = entry.data;
---

<article class={`li-post reveal ${revealClass}`}>
  <div>
    <div class="card-meta">LinkedIn Post</div>
    <h3>{p.title}</h3>
    <p class="excerpt">{p.excerpt}</p>
  </div>
  <a class="li-link" href={p.url} target="_blank" rel="noopener">
    View on LinkedIn
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M7 17V10M7 7.5V7M11 17v-4.5c0-1.4 1-2.5 2.4-2.5S16 11.1 16 12.5V17" />
      <path d="M4 4h16v16H4z" opacity="0" />
      <path d="M17 7l3-3M20 4v3h-3" />
    </svg>
  </a>
</article>
