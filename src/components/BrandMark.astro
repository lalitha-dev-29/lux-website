---
/* A flowing script "KLM" wordmark, in the spirit of the signature-style
   monogram the client is having professionally designed (black on light
   surfaces, a gold gradient on dark ones) — a placeholder built from a
   cursive webfont plus a hand-drawn flourish rather than the real
   artwork, since that hasn't been supplied as a usable asset yet. Swap
   this component's internals for an <img>/inline-SVG of the final logo
   file once it exists; every call site already just renders <BrandMark />.
   Two full copies (ink + gold) are stacked and toggled with the same
   display-swap pattern the theme-toggle sun/moon icons use, rather than a
   single recoloured copy, because the gold version is a gradient — not a
   flat colour a `currentColor` swap could produce. `id` must be unique per
   instance so the two on-page copies (nav + footer) don't collide on the
   SVG gradient's id. */
import { withBase } from '../lib/url';

interface Props {
  id: string;
}
const { id } = Astro.props;
const gradientId = `brandGold-${id}`;
---

<a href={withBase('/')} class="brand-mark" aria-label="KLM — home">
  <svg class="brand-glyph" viewBox="0 0 210 86" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#F5DFA0" />
        <stop offset="45%" stop-color="#C9A24B" />
        <stop offset="100%" stop-color="#8A6A28" />
      </linearGradient>
    </defs>
    <path
      class="brand-flourish brand-flourish-ink"
      d="M 8,70 C 30,86 56,86 74,72 C 86,62 100,62 112,70 C 128,80 150,80 166,66 C 178,56 192,58 202,68"
    />
    <path
      class="brand-flourish brand-flourish-gold"
      d="M 8,70 C 30,86 56,86 74,72 C 86,62 100,62 112,70 C 128,80 150,80 166,66 C 178,56 192,58 202,68"
      stroke={`url(#${gradientId})`}
    />
    <text class="brand-glyph-ink" x="4" y="54" font-family="'Alex Brush', cursive">KLM</text>
    <text class="brand-glyph-gold" x="4" y="54" font-family="'Alex Brush', cursive" fill={`url(#${gradientId})`}>KLM</text>
  </svg>
</a>
