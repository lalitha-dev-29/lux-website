---
import { withBase } from '../lib/url';

const cvHref = withBase('/assets/Lalitha-Manogna-Kasturi-CV.pdf');
---

<div class="connect-form-wrap reveal reveal-delay-1">
  <form id="connectForm">
    <div class="field">
      <label for="cname">Name</label>
      <input id="cname" name="name" type="text" placeholder="Your full name" required />
    </div>
    <div class="field">
      <label for="cmobile">Mobile Number</label>
      <input id="cmobile" name="mobile" type="tel" placeholder="+1 555 000 0000" required />
    </div>
    <div class="field">
      <label for="cemail">Email</label>
      <input id="cemail" name="email" type="email" placeholder="you@example.com" required />
    </div>
    <div class="field">
      <label for="creason">Reason for Contacting</label>
      <select id="creason" name="reason" class="field-select" required>
        <option value="" disabled selected>Select a reason</option>
        <option>Collaboration / Research</option>
        <option>Job Opportunity</option>
        <option>Speaking / Press</option>
        <option>General Inquiry</option>
        <option>Other</option>
      </select>
    </div>
    <p class="form-error" id="formError" role="alert" hidden>Something went wrong sending your message. Please try again or email me directly.</p>
    <p class="form-error" id="formRateLimited" role="alert" hidden>You've already sent a message from this email today. I'll get back to you soon — try again tomorrow if it's urgent.</p>
    <button type="submit" class="btn-solid" id="connectSubmitBtn">Submit &amp; Unlock CV</button>
  </form>
  <div class="resume-panel" id="resumePanel">
    <div class="check">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12.5L9.5 18L20 6" stroke="#A9863F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <h3>Thank you, details received</h3>
    <p>My CV is ready to download below. I'll also get back to you by email or phone shortly.</p>
    <div class="actions">
      <a class="btn-solid" href={cvHref} id="resumeDownloadBtn" download="Lalitha-Manogna-Kasturi-CV.pdf">Download CV</a>
      <button type="button" class="reset-link" id="resumeResetBtn">Send another message</button>
    </div>
  </div>
</div>

<script>
  import emailjs from '@emailjs/browser';

  /* ============ CONNECT FORM / CV GATE ============ */
  const connectForm = document.getElementById('connectForm') as HTMLFormElement | null;
  const resumePanel = document.getElementById('resumePanel');
  const resumeResetBtn = document.getElementById('resumeResetBtn');
  const resumeDownloadBtn = document.getElementById('resumeDownloadBtn') as HTMLAnchorElement | null;
  const submitBtn = document.getElementById('connectSubmitBtn') as HTMLButtonElement | null;
  const formError = document.getElementById('formError');
  const formRateLimited = document.getElementById('formRateLimited');

  const EMAILJS_SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID as string | undefined;
  const EMAILJS_TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID as string | undefined;
  const EMAILJS_PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY as string | undefined;

  /* Client-side "1 message per email per day" deterrent. This stops accidental
     double-submits and casual repeat use through the form itself, but it is NOT a
     real abuse defense: it lives in localStorage, so a private window, a different
     browser, or simply clearing site data resets it. Real protection against
     someone draining the EmailJS free quota has to happen on EmailJS's side (domain
     allowlist + optional CAPTCHA on the template) — see README for setup. */
  const RATE_LIMIT_KEY_PREFIX = 'lmk_contact_last_sent_';
  const RATE_LIMIT_WINDOW_MS = 24 * 60 * 60 * 1000;

  function rateLimitKeyFor(email: string) {
    return RATE_LIMIT_KEY_PREFIX + email.trim().toLowerCase();
  }

  function isRateLimited(email: string): boolean {
    try {
      const last = localStorage.getItem(rateLimitKeyFor(email));
      return !!last && Date.now() - Number(last) < RATE_LIMIT_WINDOW_MS;
    } catch {
      return false; // localStorage unavailable (e.g. blocked) — don't block sending over it
    }
  }

  function recordSend(email: string) {
    try {
      localStorage.setItem(rateLimitKeyFor(email), String(Date.now()));
    } catch {
      /* ignore */
    }
  }

  if (connectForm && resumePanel && submitBtn) {
    connectForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!connectForm.checkValidity()) {
        connectForm.reportValidity();
        return;
      }
      formError?.setAttribute('hidden', '');
      formRateLimited?.setAttribute('hidden', '');

      const emailValue = (document.getElementById('cemail') as HTMLInputElement).value;
      if (isRateLimited(emailValue)) {
        formRateLimited?.removeAttribute('hidden');
        return;
      }

      if (!EMAILJS_SERVICE_ID || !EMAILJS_TEMPLATE_ID || !EMAILJS_PUBLIC_KEY) {
        /* EmailJS isn't configured (no PUBLIC_EMAILJS_* env vars at build time) — fall
           back to the CV-gate-only behavior instead of pretending to send anything. */
        connectForm.style.display = 'none';
        resumePanel.classList.add('show');
        return;
      }

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const formData = new FormData(connectForm);
      const templateParams = {
        name: formData.get('name'),
        mobile: formData.get('mobile'),
        email: formData.get('email'),
        reason: formData.get('reason'),
      };
      const timeout = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 10000));

      try {
        await Promise.race([
          emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams, { publicKey: EMAILJS_PUBLIC_KEY }),
          timeout,
        ]);
        recordSend(emailValue);
        connectForm.style.display = 'none';
        resumePanel.classList.add('show');
      } catch {
        formError?.removeAttribute('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
    resumeResetBtn?.addEventListener('click', () => {
      connectForm.reset();
      connectForm.style.display = '';
      resumePanel.classList.remove('show');
    });
  }

  /* Upload your CV to public/assets/Lalitha-Manogna-Kasturi-CV.pdf. Until that file
     exists, the button tells the visitor to email instead of failing silently. */
  if (resumeDownloadBtn) {
    resumeDownloadBtn.addEventListener('click', async (e) => {
      try {
        const res = await fetch(resumeDownloadBtn.getAttribute('href')!, { method: 'HEAD' });
        if (!res.ok) throw new Error('missing');
      } catch {
        e.preventDefault();
        resumeDownloadBtn.textContent = 'CV coming soon, email me for a copy';
        resumeDownloadBtn.setAttribute('aria-disabled', 'true');
      }
    });
  }
</script>
