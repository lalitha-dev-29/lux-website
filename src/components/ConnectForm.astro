---
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY as string | undefined;
---

<div class="connect-form-wrap reveal reveal-delay-1">
  <form id="connectForm" novalidate>
    <h2 class="visually-hidden">Send me a message</h2>

    <div class="field" id="fieldName">
      <label for="cname">Name</label>
      <input id="cname" name="name" type="text" placeholder="Your full name" required autocomplete="name" aria-describedby="nameError" />
      <p class="field-error" id="nameError" hidden></p>
    </div>

    <div class="field" id="fieldMobile">
      <label for="cmobile">Mobile Number</label>
      <input id="cmobile" name="mobile" type="tel" placeholder="Mobile number" required autocomplete="tel" aria-describedby="mobileError" />
      <p class="field-error" id="mobileError" hidden></p>
    </div>

    <div class="field" id="fieldEmail">
      <label for="cemail">Email</label>
      <input id="cemail" name="email" type="email" placeholder="you@example.com" required autocomplete="email" aria-describedby="emailError" />
      <p class="field-error" id="emailError" hidden></p>
    </div>

    <div class="field" id="fieldReason">
      <label for="creason">Reason for Contacting</label>
      <select id="creason" name="reason" class="field-select" required aria-describedby="reasonError">
        <option value="" disabled selected>Select a reason</option>
        <option>Collaboration / Research</option>
        <option>Job Opportunity</option>
        <option>Speaking / Press</option>
        <option>General Inquiry</option>
        <option>Other</option>
      </select>
      <p class="field-error" id="reasonError" hidden></p>
    </div>

    <div class="field" id="fieldMessage" hidden>
      <label for="cmessage" id="messageLabel">Your Message</label>
      <textarea id="cmessage" name="message" placeholder="Tell me a bit about why you're reaching out." aria-describedby="messageError"></textarea>
      <p class="field-error" id="messageError" hidden></p>
    </div>

    {recaptchaSiteKey && (
      <div class="field">
        <div class="g-recaptcha" data-sitekey={recaptchaSiteKey}></div>
        <p class="field-error" id="formCaptchaRequired" hidden>Please complete the "I'm not a robot" check above before submitting.</p>
      </div>
    )}

    {/* Announced to screen readers the moment a submission fails. */}
    <div aria-live="polite" aria-atomic="true">
      <p class="form-error" id="formError" hidden>Something went wrong sending your message. Please try again or email me directly.</p>
      <p class="form-notice" id="formRateLimited" hidden>You've already sent a message from this email today. I'll get back to you soon — try again tomorrow if it's urgent.</p>
    </div>

    <button type="submit" class="btn-solid" id="connectSubmitBtn">Submit</button>
  </form>

  <div class="resume-panel" id="resumePanel" role="status" aria-live="polite">
    <div class="check" aria-hidden="true">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 12.5L9.5 18L20 6" stroke="#866A32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <h3 id="resumeHeading">Thank you, details received</h3>
    <p id="resumeBody">I'll get back to you by email or phone shortly.</p>
    <div class="actions">
      <button type="button" class="reset-link" id="resumeResetBtn">Send another message</button>
    </div>
  </div>
</div>

{recaptchaSiteKey && <script src="https://www.google.com/recaptcha/api.js" async defer is:inline></script>}

<script>
  import emailjs from '@emailjs/browser';
  import intlTelInput from 'intl-tel-input';
  import type { Iti } from 'intl-tel-input';
  import 'intl-tel-input/styles';

  declare global {
    interface Window {
      grecaptcha?: {
        getResponse: (widgetId?: number) => string;
        reset: (widgetId?: number) => void;
      };
    }
  }

  /* ============ REASON-DEPENDENT BEHAVIOR ============
     Only these two reasons unlock the CV; everything else is just a message. */
  const CV_UNLOCK_REASONS = new Set(['Job Opportunity', 'Collaboration / Research']);

  const MESSAGE_PROMPTS: Record<string, { label: string; placeholder: string }> = {
    'Job Opportunity': {
      label: 'About the Role',
      placeholder: 'Tell me about the role, the company, and the opportunity.',
    },
    'Collaboration / Research': {
      label: 'About the Collaboration',
      placeholder: 'Tell me about the collaboration proposal, research topic, or project you have in mind.',
    },
    'Speaking / Press': {
      label: 'About the Feature',
      placeholder: 'Tell me about the event, publication, or feature you have in mind.',
    },
    'General Inquiry': {
      label: 'Your Question',
      placeholder: 'What would you like to know?',
    },
    Other: {
      label: 'Your Message',
      placeholder: "Tell me a bit about why you're reaching out.",
    },
  };

  const connectForm = document.getElementById('connectForm') as HTMLFormElement | null;
  const reasonSelect = document.getElementById('creason') as HTMLSelectElement | null;
  const messageField = document.getElementById('fieldMessage');
  const messageLabel = document.getElementById('messageLabel');
  const messageInput = document.getElementById('cmessage') as HTMLTextAreaElement | null;
  const submitBtn = document.getElementById('connectSubmitBtn') as HTMLButtonElement | null;
  const mobileInput = document.getElementById('cmobile') as HTMLInputElement | null;
  const resumePanel = document.getElementById('resumePanel');
  const resumeHeading = document.getElementById('resumeHeading');
  const resumeBody = document.getElementById('resumeBody');
  const resumeResetBtn = document.getElementById('resumeResetBtn');
  const formError = document.getElementById('formError');
  const formRateLimited = document.getElementById('formRateLimited');
  const formCaptchaRequired = document.getElementById('formCaptchaRequired');

  /* ---------- field-level error helpers ---------- */
  function setFieldError(fieldId: string, errorId: string, message: string | null) {
    const field = document.getElementById(fieldId);
    const err = document.getElementById(errorId);
    const control = field?.querySelector('input, select, textarea') as HTMLElement | null;
    if (!field || !err) return;

    if (message) {
      field.classList.add('has-error');
      err.textContent = message;
      err.hidden = false;
      control?.setAttribute('aria-invalid', 'true');
    } else {
      field.classList.remove('has-error');
      err.hidden = true;
      err.textContent = '';
      control?.removeAttribute('aria-invalid');
    }
  }

  function clearAllErrors() {
    setFieldError('fieldName', 'nameError', null);
    setFieldError('fieldMobile', 'mobileError', null);
    setFieldError('fieldEmail', 'emailError', null);
    setFieldError('fieldReason', 'reasonError', null);
    setFieldError('fieldMessage', 'messageError', null);
    formError!.hidden = true;
    formRateLimited!.hidden = true;
    if (formCaptchaRequired) formCaptchaRequired.hidden = true;
  }

  /* ---------- reason drives the button label + message prompt ---------- */
  function isCvUnlockReason(reason: string) {
    return CV_UNLOCK_REASONS.has(reason);
  }

  function updateForReason() {
    const reason = reasonSelect?.value ?? '';
    const prompt = MESSAGE_PROMPTS[reason];

    if (submitBtn) submitBtn.textContent = isCvUnlockReason(reason) ? 'Submit & Unlock CV' : 'Submit';

    if (prompt && messageField && messageLabel && messageInput) {
      messageField.hidden = false;
      messageLabel.textContent = prompt.label;
      messageInput.placeholder = prompt.placeholder;
      messageInput.required = true;
    } else if (messageField && messageInput) {
      messageField.hidden = true;
      messageInput.required = false;
    }
  }

  reasonSelect?.addEventListener('change', () => {
    setFieldError('fieldReason', 'reasonError', null);
    updateForReason();
  });
  updateForReason();

  /* ---------- phone: country code, formatting, validation ---------- */
  let phoneIti: Iti | null = null;
  if (mobileInput) {
    phoneIti = intlTelInput(mobileInput, {
      initialCountry: 'sg',
      separateDialCode: true,
      loadUtils: () => import('intl-tel-input/utils'),
    });
  }

  const PHONE_ERROR_MESSAGES: Record<string, string> = {
    INVALID_COUNTRY_CODE: 'Please select a valid country code.',
    TOO_SHORT: 'This number looks too short for the selected country.',
    TOO_LONG: 'This number looks too long for the selected country.',
    IS_POSSIBLE_LOCAL_ONLY: 'Please include the area code, not just the local number.',
    INVALID_LENGTH: "This doesn't look like a valid number length for the selected country.",
  };

  async function validatePhone(): Promise<boolean> {
    if (!phoneIti || !mobileInput) return true;
    await phoneIti.promise;

    if (!mobileInput.value.trim()) {
      setFieldError('fieldMobile', 'mobileError', 'Please enter a mobile number.');
      return false;
    }
    if (phoneIti.isValidNumber()) {
      setFieldError('fieldMobile', 'mobileError', null);
      return true;
    }
    const code = phoneIti.getValidationError();
    setFieldError(
      'fieldMobile',
      'mobileError',
      (code && PHONE_ERROR_MESSAGES[code]) || 'Please enter a valid mobile number.'
    );
    return false;
  }

  mobileInput?.addEventListener('blur', () => {
    if (mobileInput.value.trim()) validatePhone();
  });
  mobileInput?.addEventListener('input', () => setFieldError('fieldMobile', 'mobileError', null));
  document.getElementById('cname')?.addEventListener('input', () => setFieldError('fieldName', 'nameError', null));
  document.getElementById('cemail')?.addEventListener('input', () => setFieldError('fieldEmail', 'emailError', null));
  messageInput?.addEventListener('input', () => setFieldError('fieldMessage', 'messageError', null));

  /* ---------- success panel ---------- */
  function showSuccessPanel(cvUnlocked: boolean) {
    if (!connectForm || !resumePanel) return;
    if (resumeHeading) resumeHeading.textContent = cvUnlocked ? 'Thank you, details received' : 'Thank you, message received';
    if (resumeBody) {
      resumeBody.textContent = cvUnlocked
        ? "I'll follow up by email with my CV and next steps shortly."
        : "I'll get back to you by email or phone shortly.";
    }
    connectForm.style.display = 'none';
    resumePanel.classList.add('show');
    resumePanel.focus?.();
  }

  /* ---------- 1 message per email per day (client-side deterrent) ---------- */
  const RATE_LIMIT_KEY_PREFIX = 'lmk_contact_last_sent_';
  const RATE_LIMIT_WINDOW_MS = 24 * 60 * 60 * 1000;
  const rateKey = (email: string) => RATE_LIMIT_KEY_PREFIX + email.trim().toLowerCase();

  function isRateLimited(email: string) {
    try {
      const last = localStorage.getItem(rateKey(email));
      return !!last && Date.now() - Number(last) < RATE_LIMIT_WINDOW_MS;
    } catch {
      return false;
    }
  }
  function recordSend(email: string) {
    try {
      localStorage.setItem(rateKey(email), String(Date.now()));
    } catch {
      /* ignore */
    }
  }

  const EMAILJS_SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID as string | undefined;
  const EMAILJS_TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID as string | undefined;
  const EMAILJS_PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY as string | undefined;
  const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY as string | undefined;

  const resetCaptcha = () => window.grecaptcha?.reset();

  if (connectForm && resumePanel && submitBtn) {
    connectForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors();

      /* Validate every field first so the user sees all problems at once,
         then move focus to the first one rather than only flagging it. */
      let firstInvalid: HTMLElement | null = null;
      const nameEl = document.getElementById('cname') as HTMLInputElement;
      const emailEl = document.getElementById('cemail') as HTMLInputElement;

      if (!nameEl.value.trim()) {
        setFieldError('fieldName', 'nameError', 'Please enter your name.');
        firstInvalid ||= nameEl;
      }
      const phoneOk = await validatePhone();
      if (!phoneOk) firstInvalid ||= mobileInput;
      if (!emailEl.value.trim()) {
        setFieldError('fieldEmail', 'emailError', 'Please enter your email address.');
        firstInvalid ||= emailEl;
      } else if (!emailEl.checkValidity()) {
        setFieldError('fieldEmail', 'emailError', 'Please enter a valid email address, like you@example.com.');
        firstInvalid ||= emailEl;
      }
      if (!reasonSelect?.value) {
        setFieldError('fieldReason', 'reasonError', 'Please choose a reason so I know how to help.');
        firstInvalid ||= reasonSelect;
      }
      if (messageInput?.required && !messageInput.value.trim()) {
        setFieldError('fieldMessage', 'messageError', 'Please add a short message.');
        firstInvalid ||= messageInput;
      }

      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const emailValue = emailEl.value;
      if (isRateLimited(emailValue)) {
        formRateLimited!.hidden = false;
        return;
      }

      const reasonValue = reasonSelect?.value ?? '';
      const cvUnlocked = isCvUnlockReason(reasonValue);

      if (!EMAILJS_SERVICE_ID || !EMAILJS_TEMPLATE_ID || !EMAILJS_PUBLIC_KEY) {
        showSuccessPanel(cvUnlocked);
        return;
      }

      let captchaToken: string | undefined;
      if (RECAPTCHA_SITE_KEY) {
        captchaToken = window.grecaptcha?.getResponse();
        if (!captchaToken) {
          if (formCaptchaRequired) formCaptchaRequired.hidden = false;
          return;
        }
      }

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.dataset.busy = 'true';
      submitBtn.setAttribute('aria-busy', 'true');

      const formData = new FormData(connectForm);
      const templateParams: Record<string, unknown> = {
        name: formData.get('name'),
        mobile: phoneIti?.getNumber() || formData.get('mobile'),
        email: formData.get('email'),
        reason: reasonValue,
        message: formData.get('message'),
      };
      if (captchaToken) templateParams['g-recaptcha-response'] = captchaToken;

      const timeout = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 10000));

      try {
        await Promise.race([
          emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams, { publicKey: EMAILJS_PUBLIC_KEY }),
          timeout,
        ]);
        recordSend(emailValue);
        showSuccessPanel(cvUnlocked);
      } catch {
        formError!.hidden = false;
        submitBtn.disabled = false;
        delete submitBtn.dataset.busy;
        submitBtn.removeAttribute('aria-busy');
        submitBtn.textContent = originalLabel;
        resetCaptcha();
      }
    });

    resumeResetBtn?.addEventListener('click', () => {
      connectForm.reset();
      connectForm.style.display = '';
      resumePanel.classList.remove('show');
      submitBtn.disabled = false;
      delete submitBtn.dataset.busy;
      submitBtn.removeAttribute('aria-busy');
      clearAllErrors();
      resetCaptcha();
      updateForReason();
      (document.getElementById('cname') as HTMLInputElement | null)?.focus();
    });
  }
</script>
