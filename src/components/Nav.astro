---
import { withBase } from '../lib/url';
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/journal/', label: 'Journal' },
  { href: '/learning/', label: 'Learning' },
  { href: '/atlas/', label: 'Atlas' },
  { href: '/connect/', label: 'Work With Me' },
];

const currentPath = Astro.url.pathname;
function isCurrent(href: string) {
  const target = withBase(href);
  return currentPath === target || (href !== '/' && currentPath.startsWith(target));
}
---

<header class="site-nav" id="siteNav">
  <div class="nav-inner">
    <a href={withBase('/')} class="brand-mark" aria-label="Kasturi Lalitha Manogna — home"><Logo class="logo-mark" /></a>

    <div class="nav-controls">
      <nav class="primary-links" id="primaryLinks" aria-label="Primary">
        {links.map((link) => (
          <a href={withBase(link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>

      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.5M12 19v2.5M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2.5 12H5M19 12h2.5M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
        </svg>
      </button>

      <button
        class="nav-toggle"
        id="navToggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primaryLinks"
      >
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
