---
import { withBase } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/journal/', label: 'Journal' },
  { href: '/learning/', label: 'Learning' },
  { href: '/atlas/', label: 'Atlas' },
  { href: '/connect/', label: 'Work With Me' },
];

const currentPath = Astro.url.pathname;
function isCurrent(href: string) {
  const target = withBase(href);
  return currentPath === target || (href !== '/' && currentPath.startsWith(target));
}
---

<header class="site-nav" id="siteNav">
  <div class="nav-inner">
    <a href={withBase('/')} class="brand-mark" aria-label="LMK — home">LMK<span class="dot" aria-hidden="true"></span></a>
    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="primaryLinks"
    >
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <nav class="primary-links" id="primaryLinks" aria-label="Primary">
      {links.map((link) => (
        <a href={withBase(link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
