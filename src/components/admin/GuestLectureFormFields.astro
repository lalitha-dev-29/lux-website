---
// Shared field markup for src/pages/admin/guest-lectures/new.astro and edit.astro.
// Behaviour (speaker repeater, photo/handout handling, save) lives in
// src/lib/guestLectureEditor.ts.
import GalleryEditor from './GalleryEditor.astro';
---

<div class="field">
  <label for="fTopic">Topic of the Guest Lecture</label>
  <input id="fTopic" name="topic" type="text" required maxlength="200" placeholder="e.g. Building Heritage Brands in the Digital Age" />
</div>

<div class="field">
  <label for="fTags">Tags <span class="hint-inline">(optional)</span></label>
  <input id="fTags" name="tags" type="text" maxlength="300" placeholder="Comma separated, e.g. Luxury Strategy, Branding, Gen Z" />
  <p class="hint">Your own labels to tell the subjects of lectures apart. They appear next to the title on the website and in this panel.</p>
  <div id="tagSuggestions" class="tag-suggestions" hidden></div>
</div>

<div class="field">
  <label for="fLectureDate">Date of the Lecture</label>
  <input id="fLectureDate" name="lecture_date" type="date" required />
  <p class="hint">Lectures are listed newest first.</p>
</div>

<div class="field">
  <label for="fCoreQuestion">Session Core Question <span class="hint-inline">(optional)</span></label>
  <input id="fCoreQuestion" name="core_question" type="text" maxlength="300" placeholder="e.g. How do you get back in the game when the rules change?" />
  <p class="hint">The one question the session set out to answer. Shown in a highlighted box at the top of the lecture page.</p>
</div>

<fieldset class="field-group">
  <legend>Guest Speakers</legend>
  <p class="hint">Add one speaker, or several if the session had a panel. Everything except the name is optional.</p>
  <div id="speakersList"></div>
  <button type="button" class="btn-line" id="addSpeakerBtn">+ Add Another Speaker</button>
</fieldset>

<template id="speakerTemplate">
  <div class="speaker-card">
    <div class="speaker-card-head">
      <h3 class="speaker-heading">Speaker 1</h3>
      <button type="button" class="btn-line speaker-remove" hidden>Remove Speaker</button>
    </div>

    <div class="field">
      <label>Name</label>
      <input type="text" class="speaker-name" maxlength="120" placeholder="e.g. Jane Doe" />
    </div>

    <div class="field">
      <label>Role / Organisation <span class="hint-inline">(optional)</span></label>
      <input type="text" class="speaker-role" maxlength="160" placeholder="e.g. Chief Marketing Officer, Maison Example" />
    </div>

    <div class="field">
      <label>Photos <span class="hint-inline">(optional — add as many as you like)</span></label>
      <div class="speaker-photos"></div>
      <input type="file" class="speaker-photo-input" accept="image/jpeg,image/png,image/webp" multiple />
      <p class="form-error speaker-photo-error" hidden></p>
      <p class="hint">JPG, PNG or WebP, up to 10MB each.</p>
    </div>

    <div class="field">
      <label>About the Speaker <span class="hint-inline">(optional)</span></label>
      <textarea class="speaker-description" rows="5" maxlength="3000" placeholder="Background, career highlights, anything worth remembering about them…"></textarea>
    </div>

    <div class="field">
      <label>A Quote I Remember <span class="hint-inline">(optional)</span></label>
      <textarea class="speaker-quote" rows="2" maxlength="500" placeholder="Something this speaker said that stuck with you…"></textarea>
    </div>
  </div>
</template>

<div class="field">
  <label for="fKeyLearnings">What I Learned</label>
  <textarea id="fKeyLearnings" name="key_learnings" required rows="10" maxlength="6000" placeholder="My key takeaways and insights from the session — put each point on its own line…"></textarea>
  <p class="hint">
    Put each point on its own line. A line written as <code>Title: explanation</code> becomes its own numbered takeaway card.
    Lines before the first takeaway become the introduction, and lines after the last one (e.g. "Overall, …") become the highlighted Core Takeaway.
  </p>
</div>

<fieldset class="field-group">
  <legend>About the Company <span class="hint-inline">(optional)</span></legend>
  <p class="hint">A short profile of the speaker's company. It appears as a "Behind the Brand" section on the lecture page. Needs the lecture_company.sql update in Supabase.</p>

  <div class="field">
    <label for="fCompanyName">Company / Brand Name</label>
    <input id="fCompanyName" type="text" maxlength="120" placeholder="e.g. Chopard" />
  </div>

  <div class="field">
    <label for="fCompanyWebsite">Website <span class="hint-inline">(optional)</span></label>
    <input id="fCompanyWebsite" type="url" maxlength="300" placeholder="https://www.example.com" />
  </div>

  <div class="field">
    <label for="fCompanyOverview">Overview <span class="hint-inline">(optional)</span></label>
    <textarea id="fCompanyOverview" rows="6" maxlength="3000" placeholder="Who they are, what they make, what makes them different. Leave a blank line between paragraphs."></textarea>
  </div>

  <div class="field">
    <label for="fCompanyFigures">Key Figures <span class="hint-inline">(optional)</span></label>
    <textarea id="fCompanyFigures" rows="4" maxlength="1200" placeholder={'1860 | Year founded\n2,000 | People\n45 | Crafts in-house'}></textarea>
    <p class="hint">One per line as <code>Number | What it means</code>.</p>
  </div>

  <div class="field">
    <label for="fCompanyMilestones">Milestones <span class="hint-inline">(optional)</span></label>
    <textarea id="fCompanyMilestones" rows="6" maxlength="3000" placeholder={'1860 | Founded in Sonvilier, Switzerland\n1963 | Acquired by the Scheufele family'}></textarea>
    <p class="hint">One per line as <code>Year | What happened</code>, oldest first.</p>
  </div>
</fieldset>

<GalleryEditor
  id="lectureGallery"
  label="Photos From the Session"
  hint="Photos of the room, the slides, the speakers — as many as you like. They appear as a photo grid on the lecture page and open full size when clicked. Each can have a caption; the arrows change the order. Photos are uploaded when you save."
/>

<div class="field">
  <label for="fFiles">Slides / Handouts <span class="hint-inline">(optional)</span></label>
  <ul id="filesList" class="files-list"></ul>
  <input id="fFiles" type="file" accept=".pdf,.ppt,.pptx,application/pdf,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation" multiple />
  <p class="form-error" id="fFilesError" hidden></p>
  <p class="hint">PDF or PowerPoint (.ppt / .pptx) files provided by the speaker, up to 25MB each.</p>
</div>
