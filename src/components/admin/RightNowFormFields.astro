---
// Shared field markup for src/pages/admin/learning/right-now/new.astro and edit.astro.
---

<div class="field">
  <label for="fTitle">Title</label>
  <input id="fTitle" name="title" type="text" required maxlength="120" placeholder="e.g. Luxury Strategy" />
  <p class="hint">The topic name, shown as the card heading.</p>
</div>

<div class="field">
  <label for="fBody">Description</label>
  <textarea id="fBody" name="body" required maxlength="500" rows="4" placeholder="e.g. I'm learning what makes luxury different from traditional marketing…"></textarea>
  <p class="hint">The paragraph shown under the title on the card.</p>
</div>

<div class="field">
  <label for="fOrderIndex">Display Order</label>
  <input id="fOrderIndex" name="order_index" type="number" step="1" min="1" value="1" />
  <p class="hint">Lower numbers appear first. You can also reorder from the list page.</p>
</div>
