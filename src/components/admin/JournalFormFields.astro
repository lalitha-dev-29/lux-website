{/* Shared field markup for src/pages/admin/journal/new.astro and edit.astro. Values are populated/read by each page's own script. */}
<div class="field">
  <label for="fTitle">Title</label>
  <input id="fTitle" name="title" type="text" required maxlength="200" />
</div>

<div class="field">
  <label for="fExcerpt">Excerpt</label>
  <textarea id="fExcerpt" name="excerpt" required maxlength="400" rows="3"></textarea>
  <p class="hint">Shown on the Journal listing card.</p>
</div>

<div class="field">
  <label for="fExternalUrl">LinkedIn Post URL</label>
  <input id="fExternalUrl" name="external_url" type="url" required placeholder="https://www.linkedin.com/…" />
  <p class="hint">Where the card links to.</p>
</div>
