---
interface Props {
  pdfUrl: string | null;
  title: string;
}
const { pdfUrl, title } = Astro.props;
---

{pdfUrl ? (
  <div class="pdf-viewer reveal" data-pdf-url={pdfUrl} data-pdf-title={title}>
    <div class="pdf-viewer-actions">
      <button type="button" class="btn-line" id="pdfOpenNewTabBtn">
        Open in New Tab<span class="visually-hidden"> (opens in a new tab)</span>
      </button>
    </div>

    <div class="pdf-viewer-frame" id="pdfViewerFrame" tabindex="-1">
      <div class="pdf-toolbar" id="pdfToolbar" hidden>
        <div class="pdf-toolbar-group" role="group" aria-label="View mode">
          <button type="button" id="pdfViewPageBtn" aria-pressed="false">Page</button>
          <button type="button" id="pdfViewScrollBtn" aria-pressed="true">Scroll</button>
        </div>
        <div class="pdf-toolbar-group" id="pdfPageNavGroup" hidden>
          <button type="button" id="pdfPrevBtn" aria-label="Previous page">‹</button>
          <span class="pdf-page-indicator">
            <label for="pdfPageInput" class="visually-hidden">Page number</label>
            <input type="number" id="pdfPageInput" min="1" value="1" />
            <span aria-hidden="true">/ <span id="pdfPageCount">–</span></span>
          </span>
          <button type="button" id="pdfNextBtn" aria-label="Next page">›</button>
        </div>
        <div class="pdf-toolbar-group">
          <button type="button" id="pdfZoomOutBtn" aria-label="Zoom out">−</button>
          <span class="pdf-zoom-input">
            <label for="pdfZoomInput" class="visually-hidden">Zoom percentage</label>
            <input type="number" id="pdfZoomInput" min="25" max="400" step="5" value="100" />
            <span aria-hidden="true">%</span>
          </span>
          <button type="button" id="pdfZoomInBtn" aria-label="Zoom in">+</button>
          <button type="button" id="pdfFitWidthBtn">Fit Width</button>
          <button type="button" id="pdfFitPageBtn" hidden>Fit Page</button>
        </div>
        <div class="pdf-toolbar-group">
          <button type="button" id="pdfFullscreenBtn" aria-label="Enter fullscreen">Fullscreen</button>
        </div>
      </div>

      <div class="pdf-canvas-wrap" id="pdfCanvasWrap" hidden>
        <p class="pdf-status" id="pdfStatus" role="status" aria-live="polite"></p>
        <canvas id="pdfCanvas" role="img" aria-label={`${title} — PDF preview`} hidden></canvas>
        <div class="pdf-scroll-pages" id="pdfScrollPages"></div>
      </div>

      <button type="button" class="pdf-exit-fullscreen-btn" id="pdfExitFullscreenBtn" hidden>
        <span aria-hidden="true">✕</span> Exit Fullscreen
      </button>
    </div>

    <p class="pdf-mobile-fallback" id="pdfMobileFallback" hidden>
      This PDF couldn't be displayed inline. <button type="button" class="pdf-mobile-fallback-btn" id="pdfMobileOpenBtn">Open it in a new tab</button> instead.
    </p>
  </div>
) : (
  <div class="case-pdf-empty reveal">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
    <p>No PDF attached to this case study yet.</p>
  </div>
)}

<script>
  import { initPdfViewer } from '../scripts/pdfViewer';
  // A page can render more than one of these (each Certification with a PDF
  // gets its own, inside its own lightbox dialog) — select by class rather
  // than a single hardcoded id so every instance gets wired up, not just
  // the first one in the document.
  document.querySelectorAll<HTMLElement>('.pdf-viewer[data-pdf-url]').forEach((root) => initPdfViewer(root));
</script>
