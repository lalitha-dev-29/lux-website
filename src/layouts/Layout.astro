---
import SiteMotifs from '../components/SiteMotifs.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Lalitha Manogna Kasturi, an emerging luxury marketer focused on brand strategy, consumer behaviour and culture. Case studies on Louis Vuitton, Hermes, Chanel, Cartier and Dior.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Lalitha Manogna Kasturi" />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
  <noscript>
    <style>
      /* Without JS the reveal animations never trigger, so show everything immediately. */
      .reveal{opacity:1 !important; transform:none !important;}
      nav.primary-links{position:static; transform:none; flex-direction:row; background:none; padding:0; height:auto;}
      .nav-toggle{display:none;}
    </style>
  </noscript>
</head>
<body>
  <SiteMotifs />
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
  <script src="../scripts/site.ts"></script>
</body>
</html>
