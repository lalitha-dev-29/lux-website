---
import SiteMotifs from '../components/SiteMotifs.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative image URL for social share previews. Omit to skip the og:image tag entirely. */
  ogImage?: string;
  /** Overrides the auto-derived canonical URL (Astro.url under the configured site/base). Rarely needed. */
  canonical?: string;
  /** 'article' for Journal/Case Study detail pages, 'website' (default) everywhere else. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Kasturi Lalitha Manogna, an emerging luxury marketer focused on brand strategy, consumer behaviour and culture. Case studies on Louis Vuitton, Hermes, Chanel, Cartier and Dior.',
  ogImage,
  canonical,
  ogType = 'website',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Kasturi Lalitha Manogna" />
  <meta name="theme-color" content="#F7F4EC" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#17140D" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <link rel="canonical" href={canonicalUrl} />
  <title>{title}</title>
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
  <!--
    Theme must be resolved and applied before first paint, or the page
    flashes the wrong colours for a frame — this has to be a synchronous,
    blocking inline script (not the deferred site.ts) so it runs before
    <body> is rendered. An explicit stored choice always wins; with none
    yet, `data-theme` is simply left unset and CSS falls back to
    prefers-color-scheme on its own, so this script has nothing to do
    (and nothing to get wrong) for a first-time visitor.
  -->
  <script is:inline>
    try {
      var t = localStorage.getItem('lmk-theme');
      if (t === 'light' || t === 'dark') {
        document.documentElement.setAttribute('data-theme', t);
      }
    } catch (e) {
      /* localStorage unavailable — fall back to prefers-color-scheme */
    }
  </script>
  <!--
    Scroll-reveal is opt-IN, set synchronously here so there's no flash.
    Content is visible by default in CSS; this class is what enables the
    hidden-then-fade-in state. If JS is off, this never runs and everything
    is simply visible — content is never trapped behind a failed animation.
    Users who prefer reduced motion never get the class at all.
  -->
  <script is:inline>
    try {
      if (
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('js-anim');
      }
    } catch (e) {
      /* leave content visible */
    }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteMotifs />
  <Nav />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script src="../scripts/site.ts"></script>
</body>
</html>
