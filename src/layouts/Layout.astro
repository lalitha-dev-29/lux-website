---
import SiteMotifs from '../components/SiteMotifs.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Lalitha Manogna Kasturi, an emerging luxury marketer focused on brand strategy, consumer behaviour and culture. Case studies on Louis Vuitton, Hermes, Chanel, Cartier and Dior.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Lalitha Manogna Kasturi" />
  <meta name="theme-color" content="#F7F4EC" />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
  <!--
    Scroll-reveal is opt-IN, set synchronously here so there's no flash.
    Content is visible by default in CSS; this class is what enables the
    hidden-then-fade-in state. If JS is off, this never runs and everything
    is simply visible — content is never trapped behind a failed animation.
    Users who prefer reduced motion never get the class at all.
  -->
  <script is:inline>
    try {
      if (
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('js-anim');
      }
    } catch (e) {
      /* leave content visible */
    }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteMotifs />
  <Nav />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script src="../scripts/site.ts"></script>
</body>
</html>
