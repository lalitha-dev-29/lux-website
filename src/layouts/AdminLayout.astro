---
import { withBase } from '../lib/url';
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title: string;
  /** The login page renders its own centered card and skips the topbar/auth gate. */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;

const navLinks = [
  { href: '/admin/', label: 'Dashboard' },
  { href: '/admin/journal/', label: 'Journal' },
  { href: '/admin/case-studies/', label: 'Case Studies' },
];
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600&family=Jost:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body class="admin">
  {bare ? (
    <slot />
  ) : (
    <>
      <header class="admin-topbar">
        <a class="admin-brand" href={withBase('/admin/')}>KLM Admin<span class="dot">.</span></a>
        <nav class="admin-nav" aria-label="Admin">
          {navLinks.map((link) => (
            <a href={withBase(link.href)} aria-current={currentPath.endsWith(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <button type="button" id="adminSignOutBtn">Sign Out</button>
        </nav>
      </header>
      <div id="adminGateLoading" class="admin-gate-loading">Checking access…</div>
      <main class="admin-main" id="adminMain" hidden>
        <slot />
      </main>
    </>
  )}

  <script>
    import { requireAdminOrRedirect, signOutAdmin } from '../lib/supabaseAdmin';
    import { withBase } from '../lib/url';

    const gateLoading = document.getElementById('adminGateLoading');
    const main = document.getElementById('adminMain');

    // The login page (bare=true) renders neither element and handles its own auth flow — skip the gate entirely.
    if (gateLoading && main) {
      requireAdminOrRedirect()
        .then((session) => {
          if (!session) return; // already redirecting to /admin/login/
          gateLoading.setAttribute('hidden', '');
          main.removeAttribute('hidden');
          document.dispatchEvent(new CustomEvent('admin:ready'));
        })
        .catch((err) => {
          gateLoading.textContent = err instanceof Error ? err.message : 'Failed to verify access.';
        });
    }

    document.getElementById('adminSignOutBtn')?.addEventListener('click', async () => {
      await signOutAdmin();
      window.location.href = withBase('/admin/login/');
    });
  </script>
</body>
</html>
