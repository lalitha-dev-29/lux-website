# EmailJS config for the /connect/ contact form. Get these from your EmailJS
# dashboard (emailjs.com) after creating an Email Service and a Template.
# All three must be set at build time or the form falls back to CV-gate-only
# behavior (no email sent).
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: reCAPTCHA v2 site key from google.com/recaptcha/admin (safe to be
# public — the matching secret key goes into EmailJS's template settings, never
# here). Leave unset to skip the captcha requirement entirely.
PUBLIC_RECAPTCHA_SITE_KEY=
